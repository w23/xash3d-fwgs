const int ASVGF_INDIRECT_SCALE = 2;
#define ASVGF ubo.ubo.asvgf

void readNormals(ivec2 uv, out vec3 geometry_normal, out vec3 shading_normal) {
	const vec4 n = imageLoad(normals_gs, uv);
	geometry_normal = normalDecode(n.xy);
	shading_normal = normalDecode(n.zw);
}

struct LuminanceStats {
	float mean;
	float variance;
	float deflicker_luma;
};

struct CurrentLuminanceStats {
	LuminanceStats direct_diffuse;
	LuminanceStats direct_specular;
	LuminanceStats indirect_diffuse;
	LuminanceStats indirect_specular;
};

struct AsvgfGateState {
	float reset_factor;
	float variance_gate;
	float variance_reset_boost;
	float current_luma;
	float history_luma;
	bool hard_reset;
};

struct AsvgfLobeContext {
	vec3 current_color;
	vec3 history_color;
	LuminanceStats current_stats;
	LuminanceStats history_stats;
	float history_samples;
	bool history_valid;
};

struct AsvgfLobeReprojectionInput {
	AsvgfLobeContext lobe;
	AsvgfGateState external_gate;
	AsvgfGateState dependency_gate;
	bool allow_dependency_gate;
	bool force_history;
};

struct AsvgfHistoryFilterResult {
	vec3 history_color;
	float outlier;
	float external_gate_factor;
	float accumulated_luma_cap;
};

struct AsvgfLobeReprojectionResult {
	vec3 color;
	LuminanceStats stats;
	float history_samples;
	AsvgfGateState gate;
};

struct AsvgfDeflickerResult {
	vec3 color;
	float stored_luma;
};

LuminanceStats makeLuminanceStats(float mean, float variance) {
	LuminanceStats stats;
	stats.mean = max(mean, 0.0);
	stats.variance = max(variance, 0.0);
	stats.deflicker_luma = stats.mean;
	return stats;
}

LuminanceStats decodeLuminanceStats(vec4 packed) {
	LuminanceStats stats;
	stats.mean = max(packed.x, 0.0);
	stats.variance = max(packed.y, 0.0);
	stats.deflicker_luma = packed.z > 0.0 ? packed.z : stats.mean;
	return stats;
}

vec4 encodeLuminanceStats(LuminanceStats stats) {
	return vec4(max(stats.mean, 0.0), max(stats.variance, 0.0), max(stats.deflicker_luma, 0.0), 0.0);
}

CurrentLuminanceStats loadCurrentStatsFromBuffer(ivec2 pix) {
	const vec4 direct_stats = imageLoad(final_atrous_direct_stats, pix);
	const vec4 indirect_diff_stats = imageLoad(final_atrous_indirect_diffuse_stats, pix);
	const vec4 indirect_spec_stats = imageLoad(final_atrous_indirect_specular_stats, pix);

	CurrentLuminanceStats stats;
	stats.direct_diffuse = makeLuminanceStats(direct_stats.x, direct_stats.y);
	stats.direct_specular = makeLuminanceStats(direct_stats.z, direct_stats.w);
	stats.indirect_diffuse = makeLuminanceStats(indirect_diff_stats.x, indirect_diff_stats.y);
	stats.indirect_specular = makeLuminanceStats(indirect_spec_stats.x, indirect_spec_stats.y);
	return stats;
}

vec3 clampSpecularLuminance(vec3 specular, float max_luminance) {
	float lum = luminance(specular);
	if (lum <= 0.0) {
		return vec3(0.0);
	}

	float clamped = min(max_luminance, lum);
	return specular * (clamped / lum);
}

AsvgfGateState makeGate(float reset_factor, bool hard_reset) {
	AsvgfGateState gate;
	gate.reset_factor = clamp(reset_factor, 0.0, 1.0);
	gate.variance_gate = 0.0;
	gate.variance_reset_boost = 0.0;
	gate.current_luma = 0.0;
	gate.history_luma = 0.0;
	gate.hard_reset = hard_reset;
	return gate;
}

AsvgfGateState makeNeutralGate() {
	return makeGate(1.0, false);
}

AsvgfGateState makeHardResetGate() {
	return makeGate(0.0, true);
}

AsvgfGateState combineGateMin(AsvgfGateState a, AsvgfGateState b) {
	AsvgfGateState result = a;
	result.reset_factor = min(a.reset_factor, b.reset_factor);
	result.variance_gate = max(a.variance_gate, b.variance_gate);
	result.variance_reset_boost = max(a.variance_reset_boost, b.variance_reset_boost);
	result.current_luma = b.current_luma;
	result.history_luma = b.history_luma;
	result.hard_reset = a.hard_reset || b.hard_reset;
	return result;
}

AsvgfLobeContext makeLobeContext(vec3 current_color, vec3 history_color, LuminanceStats current_stats, LuminanceStats history_stats, float history_samples, bool history_valid) {
	AsvgfLobeContext ctx;
	ctx.current_color = max(current_color, vec3(0.0));
	ctx.history_color = max(history_color, vec3(0.0));
	ctx.current_stats = current_stats;
	ctx.history_stats = history_stats;
	ctx.history_samples = max(history_samples, 0.0);
	ctx.history_valid = history_valid;
	return ctx;
}

AsvgfLobeReprojectionInput makeLobeReprojectionInput(AsvgfLobeContext lobe, AsvgfGateState external_gate, AsvgfGateState dependency_gate, bool allow_dependency_gate, bool force_history) {
	AsvgfLobeReprojectionInput input_value;
	input_value.lobe = lobe;
	input_value.external_gate = external_gate;
	input_value.dependency_gate = dependency_gate;
	input_value.allow_dependency_gate = allow_dependency_gate;
	input_value.force_history = force_history;
	return input_value;
}

float computeVarianceCompatibility(AsvgfReprojectionParams params, float current_luma, LuminanceStats current_stats, float history_luma, LuminanceStats history_stats) {
	float compatibility = 1.0;

	if (params.variance_compatibility_strategy == ASVGF_COMPATIBILITY_LUMA_DELTA) {
		float signal = max(max(current_luma, history_luma), params.variance_compatibility_signal_floor);
		float expected_delta = max(params.variance_compatibility_delta_floor, params.variance_compatibility_luma_scale * signal);
		float mismatch = abs(current_luma - history_luma) / max(expected_delta, 1e-6);
		compatibility = 1.0 - smoothstep(params.variance_compatibility_smooth_min, params.variance_compatibility_smooth_max, mismatch);
	} else {
		float expected_sigma = sqrt(max(max(current_stats.variance, history_stats.variance), 0.0));
		float signal = max(current_stats.mean, history_stats.mean);
		float expected_delta = max(expected_sigma + params.variance_compatibility_luma_scale * signal, params.variance_compatibility_delta_floor);
		float mismatch = max(abs(current_luma - history_luma), abs(current_stats.mean - history_stats.mean)) / max(expected_delta, 1e-6);
		compatibility = 1.0 - smoothstep(params.variance_compatibility_smooth_min, params.variance_compatibility_smooth_max, mismatch);
	}

	return max(clamp(compatibility, 0.0, 1.0), clamp(params.variance_compatibility_floor, 0.0, 1.0));
}

float softenVarianceCompatibility(AsvgfReprojectionParams params, float compatibility) {
	if (compatibility <= params.variance_soften_threshold) {
		return 0.0;
	}
	return mix(1.0, compatibility, params.variance_soften_mix);
}

float computeLumaDeltaGate(AsvgfReprojectionParams params, float current_luma, float history_luma) {
	float signal = max(max(current_luma, history_luma), params.luma_delta_gate_signal_floor);
	float normalized_delta = abs(current_luma - history_luma) / max(signal + params.luma_delta_gate_denominator_offset, 1e-6);
	return smoothstep(params.luma_delta_gate_smooth_min, params.luma_delta_gate_smooth_max, normalized_delta);
}

float computeVarianceGate(AsvgfReprojectionParams params, LuminanceStats current_stats, LuminanceStats history_stats, float current_luma, float history_luma) {
	float current_sigma = sqrt(max(current_stats.variance, 0.0));
	float history_sigma = sqrt(max(history_stats.variance, 0.0));
	float sigma = max(current_sigma, history_sigma);
	float signal = max(max(current_stats.mean, history_stats.mean), params.analytical_variance_signal_floor);
	float normalized_sigma = sigma / (signal + 1e-4);
	float stats_gate = smoothstep(params.variance_gate_min, params.variance_gate_max, normalized_sigma);
	float luma_gate = computeLumaDeltaGate(params, current_luma, history_luma);
	float gated = mix(stats_gate, max(stats_gate, luma_gate), clamp(params.luma_delta_gate_mix, 0.0, 1.0));
	return max(gated, clamp(params.variance_gate_floor, 0.0, 1.0));
}

float applyVarianceSoftReset(AsvgfReprojectionParams params, float reset_factor, float variance_gate) {
	float gate = clamp(variance_gate, 0.0, 1.0);
	float scaled_reset = reset_factor * mix(params.reset_min_scale, 1.0, gate);
	return clamp(scaled_reset, 0.0, 1.0);
}

float computeEffectiveHistorySamples(AsvgfReprojectionParams params, float history_samples, float reset_factor) {
	float clamped_reset_factor = clamp(reset_factor, 0.0, 1.0);
	float history_samples_max = max(params.history_samples_max, 1.0);
	float current_weight_min = clamp(params.history_current_weight_min, 1e-4, 1.0);
	float max_effective_history_samples = min(
		history_samples_max - 1.0,
		(1.0 / current_weight_min) - 1.0);
	return min(max(history_samples, 0.0) * clamped_reset_factor, max_effective_history_samples);
}

float computeAnalyticalVarianceCompatibility(AsvgfReprojectionParams params, LuminanceStats current_stats, LuminanceStats history_stats, float history_samples, float reset_factor) {
	float effective_history_samples = computeEffectiveHistorySamples(params, history_samples, reset_factor);
	float total_samples = effective_history_samples + 1.0;
	float history_mix = effective_history_samples / total_samples;
	float current_mix = 1.0 / total_samples;

	float current_variance = max(current_stats.variance, 0.0);
	float history_variance = max(history_stats.variance, 0.0);
	float expected_variance = history_mix * history_mix * history_variance + current_mix * current_mix * current_variance;
	float mean_delta = current_stats.mean - history_stats.mean;
	float observed_variance = expected_variance + history_mix * current_mix * mean_delta * mean_delta;

	float signal = max(max(current_stats.mean, history_stats.mean), params.analytical_variance_signal_floor);
	float variance_floor = pow(params.analytical_variance_floor_base + params.analytical_variance_floor_signal_scale * signal, 2.0);
	float variance_ratio = (observed_variance + variance_floor) / (expected_variance + variance_floor);
	float ratio_compatibility = 1.0 - smoothstep(params.analytical_variance_ratio_min, params.analytical_variance_ratio_max, variance_ratio);

	float delta_sigma = abs(mean_delta) / sqrt(max(current_variance + history_variance + variance_floor, 1e-8));
	float mean_compatibility = 1.0 - smoothstep(params.analytical_variance_mean_min, params.analytical_variance_mean_max, delta_sigma);
	return clamp(min(ratio_compatibility, mean_compatibility), 0.0, 1.0);
}

LuminanceStats accumulateHistoryStats(AsvgfReprojectionParams params, LuminanceStats current_stats, LuminanceStats history_stats, float history_samples, float reset_factor) {
	float effective_history_samples = computeEffectiveHistorySamples(params, history_samples, reset_factor);
	float total_samples = effective_history_samples + 1.0;
	float history_mix = effective_history_samples / total_samples;
	float current_mix = 1.0 / total_samples;

	LuminanceStats accumulated_stats;
	accumulated_stats.mean = mix(current_stats.mean, history_stats.mean, history_mix);
	accumulated_stats.variance =
		history_mix * history_mix * max(history_stats.variance, 0.0)
		+ current_mix * current_mix * max(current_stats.variance, 0.0);
	return accumulated_stats;
}

vec4 accumulateHistoryRadiance(AsvgfReprojectionParams params, vec3 current, vec3 history, float history_samples, float reset_factor) {
	float effective_history_samples = computeEffectiveHistorySamples(params, history_samples, reset_factor);
	float total_samples = effective_history_samples + 1.0;
	float history_mix = effective_history_samples / total_samples;
	vec3 accumulated = mix(current, history, history_mix);
	return vec4(accumulated, min(total_samples, max(params.history_samples_max, 1.0)));
}

float computeExternalGateFactor(AsvgfReprojectionParams params, AsvgfGateState external_gate) {
	float base = mix(clamp(params.external_gate_floor, 0.0, 1.0), 1.0, external_gate.reset_factor);
	return mix(1.0, base, clamp(params.external_gate_mix, 0.0, 1.0));
}

AsvgfHistoryFilterResult filterHistory(AsvgfReprojectionParams params, vec3 current_color, vec3 history_color, LuminanceStats current_stats) {
	AsvgfHistoryFilterResult result;
	result.history_color = history_color;
	result.outlier = 0.0;
	result.external_gate_factor = 1.0;
	result.accumulated_luma_cap = 1e20;

	if (params.history_luma_clamp > 0.0) {
		result.history_color = clampSpecularLuminance(result.history_color, params.history_luma_clamp);
	}

	if (params.history_filter_strategy != ASVGF_HISTORY_FILTER_LUMA_OUTLIER_CLAMP) {
		return result;
	}

	float current_sigma = sqrt(max(current_stats.variance, 0.0));
	float noise_norm = current_sigma / (current_stats.mean + max(params.history_outlier_noise_mean_floor, 1e-6));
	float noise_gate = smoothstep(params.history_outlier_noise_gate_min, params.history_outlier_noise_gate_max, noise_norm);

	float envelope_sigma_scale = mix(params.history_outlier_envelope_sigma_min, params.history_outlier_envelope_sigma_max, noise_gate);
	float envelope_mean_scale = mix(params.history_outlier_envelope_mean_min, params.history_outlier_envelope_mean_max, noise_gate);
	float envelope = max(current_sigma * envelope_sigma_scale + envelope_mean_scale * current_stats.mean, params.history_outlier_envelope_min);

	float history_delta = abs(luminance(result.history_color) - current_stats.mean);
	float outlier_lo = mix(params.history_outlier_threshold_low_min, params.history_outlier_threshold_low_max, noise_gate);
	float outlier_hi = mix(params.history_outlier_threshold_high_min, params.history_outlier_threshold_high_max, noise_gate);
	result.outlier = smoothstep(outlier_lo, outlier_hi, history_delta / max(envelope, 1e-6));

	float luma_cap_scale = mix(params.history_outlier_luma_cap_scale_min, params.history_outlier_luma_cap_scale_max, noise_gate);
	float luma_cap = max(current_stats.mean + envelope * luma_cap_scale, params.history_outlier_luma_cap_min);

	if (result.outlier > 0.0) {
		result.history_color = clampSpecularLuminance(result.history_color, luma_cap);
	}

	float attenuation = mix(params.history_outlier_external_gate_attenuation_min, params.history_outlier_external_gate_attenuation_max, noise_gate);
	result.external_gate_factor = clamp(1.0 - attenuation * result.outlier, 0.0, 1.0);

	float accumulated_scale = mix(params.history_outlier_accumulated_luma_scale_min, params.history_outlier_accumulated_luma_scale_max, noise_gate);
	result.accumulated_luma_cap = luma_cap * accumulated_scale;
	return result;
}

AsvgfGateState applyDependencyStrategy(AsvgfReprojectionParams params, AsvgfGateState gate, AsvgfGateState dependency_gate) {
	if (params.use_dependency_reset_as_gate == 0u || params.dependency_strategy == ASVGF_DEPENDENCY_NONE) {
		return gate;
	}

	if (params.dependency_strategy == ASVGF_DEPENDENCY_COMBINE_MIN) {
		return combineGateMin(gate, dependency_gate);
	}

	float dependency_boost = mix(clamp(params.dependency_gate_floor, 0.0, 1.0), 1.0, dependency_gate.reset_factor);

	if (params.dependency_strategy == ASVGF_DEPENDENCY_RELIGHT_CARRY) {
		float signal = max(max(dependency_gate.current_luma, dependency_gate.history_luma), params.dependency_luma_signal_floor);
		float relight_norm = abs(dependency_gate.current_luma - dependency_gate.history_luma) / max(signal + params.dependency_luma_denominator_offset, 1e-6);
		float relight_boost = smoothstep(params.dependency_luma_smooth_min, params.dependency_luma_smooth_max, relight_norm);
		float relight_reset = 1.0 - relight_boost * dependency_boost * clamp(params.dependency_luma_mix, 0.0, 1.0);

		float variance_reset = 1.0 - dependency_gate.variance_reset_boost * dependency_boost * clamp(params.dependency_gate_mix, 0.0, 1.0);

		float soft_carry = 1.0 - smoothstep(params.dependency_gate_soft_min, params.dependency_gate_soft_max, 1.0 - dependency_gate.reset_factor);
		soft_carry = mix(1.0, soft_carry, clamp(params.dependency_gate_mix, 0.0, 1.0));

		gate.reset_factor = min(gate.reset_factor, relight_reset);
		gate.reset_factor = min(gate.reset_factor, variance_reset);
		gate.reset_factor = min(gate.reset_factor, soft_carry);

		float off_ratio = dependency_gate.current_luma / (dependency_gate.history_luma + 1e-4);
		bool hard_off =
			(dependency_gate.history_luma > params.dependency_off_history_min)
			&& (dependency_gate.current_luma < params.dependency_off_current_max || off_ratio < params.dependency_off_ratio_min);

		if (hard_off || dependency_gate.hard_reset) {
			gate.hard_reset = true;
			gate.reset_factor = 0.0;
		}

		return gate;
	}

	if (params.dependency_strategy == ASVGF_DEPENDENCY_VARIANCE_CARRY) {
		float variance_reset = 1.0 - dependency_gate.variance_reset_boost * dependency_boost * clamp(params.dependency_gate_mix, 0.0, 1.0);
		gate.reset_factor = min(gate.reset_factor, variance_reset);

		if (dependency_gate.hard_reset) {
			gate.hard_reset = true;
			gate.reset_factor = 0.0;
		}

		return gate;
	}

	return gate;
}

vec3 setLuminancePreserveChromaticity(vec3 color, float target_luma) {
	float current_luma = luminance(color);
	if (current_luma <= 1e-6) {
		return color;
	}

	return max(color * (max(target_luma, 0.0) / current_luma), vec3(0.0));
}

AsvgfDeflickerResult applyLobeDeflicker(AsvgfReprojectionParams params, vec3 color, float previous_stabilized_luma, bool reset_memory) {
	AsvgfDeflickerResult result;
	result.color = max(color, vec3(0.0));
	result.stored_luma = luminance(result.color);

	if (params.deflicker_enabled == 0u || reset_memory) {
		return result;
	}

	float previous_luma = max(previous_stabilized_luma, 0.0);
	float current_luma = max(result.stored_luma, 0.0);
	if (previous_luma <= 0.0 || current_luma <= 0.0) {
		result.stored_luma = current_luma;
		return result;
	}

	float signal = max(max(previous_luma, current_luma), max(params.analytical_variance_signal_floor, 1e-6));
	float relative_delta = abs(current_luma - previous_luma) / signal;
	float threshold_min = min(params.deflicker_threshold_min, params.deflicker_threshold_max);
	float threshold_max = max(max(params.deflicker_threshold_min, params.deflicker_threshold_max), threshold_min + 1e-5);
	float accept_new = smoothstep(threshold_min, threshold_max, relative_delta);
	float stabilized_luma = mix(previous_luma, current_luma, accept_new);

	result.color = setLuminancePreserveChromaticity(result.color, stabilized_luma);
	result.stored_luma = stabilized_luma;
	return result;
}

AsvgfLobeReprojectionResult makeFreshLobeResult(vec3 current_color, LuminanceStats current_stats) {
	AsvgfLobeReprojectionResult result;
	result.color = max(current_color, vec3(0.0));
	result.stats = current_stats;
	result.stats.deflicker_luma = luminance(result.color);
	result.history_samples = 1.0;
	result.gate = makeHardResetGate();
	result.gate.current_luma = luminance(result.color);
	result.gate.history_luma = result.gate.current_luma;
	return result;
}

AsvgfLobeReprojectionResult reprojectAsvgfLobe(AsvgfReprojectionParams params, AsvgfLobeReprojectionInput input_value) {
	AsvgfLobeContext lobe = input_value.lobe;
	if (!lobe.history_valid) {
		return makeFreshLobeResult(lobe.current_color, lobe.current_stats);
	}

	float current_luma = luminance(lobe.current_color);
	float raw_history_luma = luminance(lobe.history_color);

	AsvgfHistoryFilterResult history_filter = filterHistory(params, lobe.current_color, lobe.history_color, lobe.current_stats);
	lobe.history_color = history_filter.history_color;

	float history_luma = luminance(lobe.history_color);

	AsvgfGateState gate = makeNeutralGate();
	gate.current_luma = current_luma;
	gate.history_luma = raw_history_luma;

	if (input_value.force_history) {
		gate.reset_factor = 1.0;
		vec4 forced_accumulated = accumulateHistoryRadiance(params, lobe.current_color, lobe.history_color, lobe.history_samples, gate.reset_factor);

		AsvgfLobeReprojectionResult forced_result;
		forced_result.color = forced_accumulated.rgb;
		AsvgfDeflickerResult forced_deflicker = applyLobeDeflicker(params, forced_result.color, lobe.history_stats.deflicker_luma, false);
		forced_result.color = forced_deflicker.color;
		forced_result.history_samples = forced_accumulated.a;
		forced_result.stats = accumulateHistoryStats(params, lobe.current_stats, lobe.history_stats, lobe.history_samples, gate.reset_factor);
		forced_result.stats.deflicker_luma = forced_deflicker.stored_luma;
		forced_result.gate = gate;
		return forced_result;
	}

	float external_factor = computeExternalGateFactor(params, input_value.external_gate) * history_filter.external_gate_factor;
	float analytical_seed = clamp(input_value.external_gate.reset_factor * history_filter.external_gate_factor, 0.0, 1.0);

	float variance_compatibility = computeVarianceCompatibility(params, current_luma, lobe.current_stats, history_luma, lobe.history_stats);
	float analytical_compatibility = computeAnalyticalVarianceCompatibility(params, lobe.current_stats, lobe.history_stats, lobe.history_samples, analytical_seed);
	variance_compatibility = min(variance_compatibility, analytical_compatibility);

	float softened_variance_compatibility = softenVarianceCompatibility(params, variance_compatibility);
	float variance_stage = mix(1.0, softened_variance_compatibility, clamp(params.variance_stage_mix, 0.0, 1.0));

	float variance_gate = computeVarianceGate(params, lobe.current_stats, lobe.history_stats, current_luma, history_luma);

	gate.reset_factor = external_factor * variance_stage;
	gate.variance_gate = variance_gate;

	if (input_value.external_gate.hard_reset) {
		gate.hard_reset = true;
		gate.reset_factor = 0.0;
	}

	if (input_value.allow_dependency_gate) {
		gate = applyDependencyStrategy(params, gate, input_value.dependency_gate);
	}

	bool variance_hard_reset =
		(variance_gate >= params.reset_hard_variance_gate)
		&& (variance_compatibility <= params.reset_hard_compatibility);

	if (gate.hard_reset || variance_hard_reset) {
		gate.hard_reset = true;
		gate.reset_factor = 0.0;
	} else {
		gate.reset_factor = applyVarianceSoftReset(params, gate.reset_factor, variance_gate);
		if (gate.reset_factor <= params.reset_hard_factor) {
			gate.hard_reset = true;
			gate.reset_factor = 0.0;
		}
	}

	gate.variance_reset_boost = smoothstep(
		params.variance_reset_boost_smooth_min,
		params.variance_reset_boost_smooth_max,
		variance_gate * (1.0 - gate.reset_factor));

	vec4 accumulated = accumulateHistoryRadiance(params, lobe.current_color, lobe.history_color, lobe.history_samples, gate.reset_factor);

	AsvgfLobeReprojectionResult result;
	result.color = accumulated.rgb;
	if (params.history_filter_strategy == ASVGF_HISTORY_FILTER_LUMA_OUTLIER_CLAMP && history_filter.outlier > 0.0) {
		result.color = clampSpecularLuminance(result.color, history_filter.accumulated_luma_cap);
	}

	bool reset_deflicker = gate.hard_reset || (input_value.allow_dependency_gate && input_value.dependency_gate.hard_reset);
	AsvgfDeflickerResult deflicker_result = applyLobeDeflicker(params, result.color, lobe.history_stats.deflicker_luma, reset_deflicker);
	result.color = deflicker_result.color;
	result.history_samples = accumulated.a;
	result.stats = accumulateHistoryStats(params, lobe.current_stats, lobe.history_stats, lobe.history_samples, gate.reset_factor);
	result.stats.deflicker_luma = deflicker_result.stored_luma;
	result.gate = gate;
	return result;
}

void main() {
	const ivec2 res = ubo.ubo.res;
	const ivec2 pix = ivec2(gl_GlobalInvocationID);

	if (any(greaterThanEqual(pix, res))) {
		return;
	}

	const vec3 position = imageLoad(position_t, pix).xyz;
	const vec4 material = imageLoad(material_rmxx, pix);
	const float current_roughness = material.x;
	const float metalness = material.g;
	const bool separated_reflection = (ubo.ubo.renderer_flags & RENDERER_FLAG_SEPARATED_REFLECTION) != 0;
	const bool legacy_bounce = !separated_reflection;

	vec3 geometry_normal, shading_normal;
	readNormals(pix, geometry_normal, shading_normal);

	const vec4 pre_asvgf_direct_diffuse_sample = imageLoad(final_atrous_direct_diffuse, pix);
	const vec4 pre_asvgf_direct_specular_sample = imageLoad(final_atrous_direct_specular, pix);
	const vec4 pre_asvgf_indirect_specular_sample = imageLoad(final_atrous_indirect_specular, pix);

	vec3 direct_diffuse = pre_asvgf_direct_diffuse_sample.rgb;
	vec3 indirect_diffuse = imageLoad(precombined_indirect_diffuse, pix).rgb;
	vec3 direct_specular = pre_asvgf_direct_specular_sample.rgb;
	vec3 indirect_specular = pre_asvgf_indirect_specular_sample.rgb;

	const CurrentLuminanceStats current_stats = loadCurrentStatsFromBuffer(pix);
	const LuminanceStats current_direct_diffuse_stats = current_stats.direct_diffuse;
	const LuminanceStats current_direct_specular_stats = current_stats.direct_specular;
	const LuminanceStats current_indirect_diffuse_stats = current_stats.indirect_diffuse;
	const LuminanceStats current_indirect_specular_stats = current_stats.indirect_specular;

	LuminanceStats asvgf_direct_diffuse_stats = current_direct_diffuse_stats;
	LuminanceStats asvgf_direct_specular_stats = current_direct_specular_stats;
	LuminanceStats asvgf_indirect_diffuse_stats = current_indirect_diffuse_stats;
	LuminanceStats asvgf_indirect_specular_stats = current_indirect_specular_stats;

	float diffuse_history_samples = 1.0;
	float indirect_diffuse_history_samples = 1.0;
	float direct_specular_history_samples = 1.0;
	float indirect_specular_history_samples = 1.0;

	const vec3 origin = (ubo.ubo.inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	const float depth = length(origin - position);

	vec3 history_direct_specular = direct_specular;

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_REPROJECTION) == 0) {
		const vec3 prev_position = imageLoad(geometry_prev_position, pix).rgb;
		ivec2 reproj_pix = ivec2(-1);
		float depth_necessary = 0.0;
		float depth_treshold = 0.0;
		reprojectToPrevFramePixel(prev_position, res, reproj_pix, depth_necessary, depth_treshold);
		const vec3 prev_origin = (ubo.ubo.prev_inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
		float better_depth_offset = depth_treshold;

		vec3 history_diffuse = direct_diffuse;
		vec3 history_indirect_diffuse = indirect_diffuse;
		vec3 history_indirect_specular = indirect_specular;

		diffuse_history_samples = 1.0;
		indirect_diffuse_history_samples = 1.0;
		direct_specular_history_samples = 1.0;
		indirect_specular_history_samples = 1.0;

		float diffuse_compatibility = 0.0;
		float indirect_diffuse_history_compatibility = 0.0;
		float direct_specular_history_compatibility = 0.0;
		float indirect_specular_history_compatibility = 0.0;

		LuminanceStats history_diffuse_stats = current_direct_diffuse_stats;
		LuminanceStats history_direct_specular_stats = current_direct_specular_stats;
		LuminanceStats history_indirect_diffuse_stats = current_indirect_diffuse_stats;
		LuminanceStats history_indirect_specular_stats = current_indirect_specular_stats;

		const float current_diffuse_luma = luminance(direct_diffuse);
		const float current_indirect_diffuse_luma = luminance(indirect_diffuse);
		const float current_direct_specular_luma = luminance(direct_specular);
		const float current_indirect_specular_luma = luminance(indirect_specular);

		const float direct_diffuse_compatibility = 1.0;
		const float indirect_diffuse_direct_compatibility = direct_diffuse_compatibility;
		const float direct_specular_compatibility = 1.0;
		const float indirect_specular_compatibility = clamp(pre_asvgf_indirect_specular_sample.a, 0.0, 1.0);
		const bool mirror_surface = (metalness >= 0.999) && (current_roughness <= 0.001);

		if (all(greaterThanEqual(reproj_pix, ivec2(0))) && all(lessThan(reproj_pix, res))) {
			const vec4 history_diffuse_sample = imageLoad(prev_temporal_asvgf_direct_diffuse, reproj_pix);
			const float history_depth = imageLoad(prev_temporal_asvgf_reproj_depth, reproj_pix).r;
			const float depth_offset = abs(history_depth - depth_necessary);
			if (depth_offset < better_depth_offset) {
				const vec4 history_indirect_diffuse_sample = imageLoad(prev_temporal_asvgf_indirect_diffuse, reproj_pix);
				better_depth_offset = depth_offset;
				history_diffuse = history_diffuse_sample.rgb;
				history_indirect_diffuse = history_indirect_diffuse_sample.rgb;
				diffuse_history_samples = max(history_diffuse_sample.a, 0.0);
				indirect_diffuse_history_samples = max(history_indirect_diffuse_sample.a, 0.0);
				diffuse_compatibility = direct_diffuse_compatibility;
				indirect_diffuse_history_compatibility = indirect_diffuse_direct_compatibility;
				history_diffuse_stats = decodeLuminanceStats(imageLoad(prev_temporal_asvgf_direct_diffuse_stats, reproj_pix));
				history_indirect_diffuse_stats = decodeLuminanceStats(imageLoad(prev_temporal_asvgf_indirect_diffuse_stats, reproj_pix));
			}
		}

		bool has_base_history = better_depth_offset < depth_treshold;

		const float average_ray_length = (separated_reflection || mirror_surface)
			? sampleAverageReflectionRayLength(pix, res, ASVGF_INDIRECT_SCALE, 1)
			: 0.0;
		ivec2 direct_specular_history_pix = reproj_pix;
		if (has_base_history) {
			const vec4 history_direct_specular_sample = imageLoad(prev_temporal_asvgf_direct_specular, direct_specular_history_pix);
			history_direct_specular = history_direct_specular_sample.xyz;
			direct_specular_history_samples = max(history_direct_specular_sample.a, 0.0);
			direct_specular_history_compatibility = direct_specular_compatibility;
			history_direct_specular_stats = decodeLuminanceStats(imageLoad(prev_temporal_asvgf_direct_specular_stats, direct_specular_history_pix));
		}

		ivec2 indirect_parallax_pix = ivec2(-1);
		bool has_indirect_specular_reprojection = false;
		if (separated_reflection || mirror_surface) {
			has_indirect_specular_reprojection = parallaxReprojectToPrevFramePixel(
				position,
				prev_position,
				geometry_normal,
				origin,
				prev_origin,
				average_ray_length,
				res,
				indirect_parallax_pix)
				&& all(greaterThanEqual(indirect_parallax_pix, ivec2(0)))
				&& all(lessThan(indirect_parallax_pix, res));
		}

		bool use_indirect_specular_parallax = false;
		ivec2 indirect_specular_history_pix = reproj_pix;
		if ((separated_reflection || mirror_surface) && has_base_history && has_indirect_specular_reprojection) {
			vec4 parallax_history_meta = imageLoad(prev_temporal_asvgf_reproj_depth, indirect_parallax_pix);
			float parallax_plane_depth = 0.0;
			bool has_parallax_plane_depth = computePlaneDepthInPrevFrame(indirect_parallax_pix, res, position, geometry_normal, parallax_plane_depth);
			if (has_parallax_plane_depth) {
				float parallax_depth_offset = abs(parallax_history_meta.r - parallax_plane_depth);
				vec3 parallax_prev_shading_normal = normalDecode(parallax_history_meta.ba);
				float parallax_normal_delta = 1.0 - saturate(dot(shading_normal, parallax_prev_shading_normal));
				float parallax_roughness_delta = abs(parallax_history_meta.g - current_roughness);
				float parallax_normal_match = 1.0 - smoothstep(ASVGF.indirect_specular.parallax_shading_normal_threshold, ASVGF.indirect_specular.parallax_shading_normal_threshold * 2.0, parallax_normal_delta);
				float parallax_roughness_match = 1.0 - smoothstep(ASVGF.indirect_specular.parallax_roughness_threshold, ASVGF.indirect_specular.parallax_roughness_threshold * 2.0, parallax_roughness_delta);
				use_indirect_specular_parallax = (parallax_depth_offset < depth_treshold * ASVGF.indirect_specular.parallax_depth_threshold_scale) && (parallax_normal_match > 0.0) && (parallax_roughness_match > 0.0);
			}
		}

		if (has_base_history) {
			if (use_indirect_specular_parallax) {
				indirect_specular_history_pix = indirect_parallax_pix;
			}

			const vec4 history_indirect_specular_sample = imageLoad(prev_temporal_asvgf_indirect_specular, indirect_specular_history_pix);
			history_indirect_specular = history_indirect_specular_sample.xyz;
			indirect_specular_history_samples = max(history_indirect_specular_sample.a, 0.0);
			indirect_specular_history_compatibility = indirect_diffuse_direct_compatibility * indirect_specular_compatibility;
			history_indirect_specular_stats = decodeLuminanceStats(imageLoad(prev_temporal_asvgf_indirect_specular_stats, indirect_specular_history_pix));
		}

#ifdef DEBUG_VALIDATE_EXTRA
		if (IS_INVALIDV(history_direct_specular)) {
			debugPrintfEXT("PRE pix=(%d,%d) history_direct_specular=inv", pix.x, pix.y);
			history_direct_specular = vec3(0.0);
		}
#endif

		bool has_diffuse_history = has_base_history;
		bool has_indirect_diffuse_history = has_base_history;
		bool has_direct_specular_history = has_base_history;
		bool has_indirect_specular_history = has_base_history;

		AsvgfGateState neutral_gate = makeNeutralGate();
		AsvgfGateState direct_diffuse_external_gate = makeGate(diffuse_compatibility, diffuse_compatibility <= ASVGF.direct_diffuse.external_gate_hard_threshold);
		AsvgfGateState direct_specular_external_gate = makeGate(direct_specular_history_compatibility, direct_specular_history_compatibility <= ASVGF.direct_specular.external_gate_hard_threshold);
		AsvgfGateState indirect_diffuse_external_gate = makeGate(indirect_diffuse_history_compatibility, indirect_diffuse_history_compatibility <= ASVGF.indirect_diffuse.external_gate_hard_threshold);
		AsvgfGateState indirect_specular_external_gate = makeGate(indirect_specular_history_compatibility, indirect_specular_history_compatibility <= ASVGF.indirect_specular.external_gate_hard_threshold);

		AsvgfLobeReprojectionResult direct_diffuse_result = reprojectAsvgfLobe(
			ASVGF.direct_diffuse,
			makeLobeReprojectionInput(
				makeLobeContext(
					direct_diffuse,
					history_diffuse,
					current_direct_diffuse_stats,
					history_diffuse_stats,
					diffuse_history_samples,
					has_diffuse_history),
				direct_diffuse_external_gate,
				neutral_gate,
				false,
				false));

		AsvgfLobeReprojectionResult direct_specular_result = reprojectAsvgfLobe(
			ASVGF.direct_specular,
			makeLobeReprojectionInput(
				makeLobeContext(
					direct_specular,
					history_direct_specular,
					current_direct_specular_stats,
					history_direct_specular_stats,
					direct_specular_history_samples,
					has_direct_specular_history),
				direct_specular_external_gate,
				direct_diffuse_result.gate,
				true,
				false));

		AsvgfGateState indirect_dependency_gate = legacy_bounce ? neutral_gate : direct_diffuse_result.gate;

		AsvgfLobeReprojectionResult indirect_diffuse_result = reprojectAsvgfLobe(
			ASVGF.indirect_diffuse,
			makeLobeReprojectionInput(
				makeLobeContext(
					indirect_diffuse,
					history_indirect_diffuse,
					current_indirect_diffuse_stats,
					history_indirect_diffuse_stats,
					indirect_diffuse_history_samples,
					has_indirect_diffuse_history),
				legacy_bounce ? neutral_gate : indirect_diffuse_external_gate,
				indirect_dependency_gate,
				true,
				legacy_bounce));

		AsvgfLobeReprojectionResult indirect_specular_result = reprojectAsvgfLobe(
			ASVGF.indirect_specular,
			makeLobeReprojectionInput(
				makeLobeContext(
					indirect_specular,
					history_indirect_specular,
					current_indirect_specular_stats,
					history_indirect_specular_stats,
					indirect_specular_history_samples,
					has_indirect_specular_history),
				legacy_bounce ? neutral_gate : indirect_specular_external_gate,
				indirect_dependency_gate,
				true,
				legacy_bounce));

		direct_diffuse = direct_diffuse_result.color;
		diffuse_history_samples = direct_diffuse_result.history_samples;
		asvgf_direct_diffuse_stats = direct_diffuse_result.stats;

		direct_specular = direct_specular_result.color;
		direct_specular_history_samples = direct_specular_result.history_samples;
		asvgf_direct_specular_stats = direct_specular_result.stats;

		indirect_diffuse = indirect_diffuse_result.color;
		indirect_diffuse_history_samples = indirect_diffuse_result.history_samples;
		asvgf_indirect_diffuse_stats = indirect_diffuse_result.stats;

		indirect_specular = indirect_specular_result.color;
		indirect_specular_history_samples = indirect_specular_result.history_samples;
		asvgf_indirect_specular_stats = indirect_specular_result.stats;
	}

	DEBUG_VALIDATE_RANGE_VEC3("asvgf.direct_diffuse", direct_diffuse, 0.0, 1e6);
	DEBUG_VALIDATE_RANGE_VEC3("asvgf.indirect_diffuse", indirect_diffuse, 0.0, 1e6);
	DEBUG_VALIDATE_RANGE_VEC3("asvgf.direct_specular", direct_specular, 0.0, 1e6);
	DEBUG_VALIDATE_RANGE_VEC3("asvgf.indirect_specular", indirect_specular, 0.0, 1e6);

	imageStore(out_temporal_asvgf_direct_diffuse, pix, vec4(direct_diffuse, diffuse_history_samples));
	imageStore(out_temporal_asvgf_indirect_diffuse, pix, vec4(indirect_diffuse, indirect_diffuse_history_samples));
	imageStore(out_temporal_asvgf_direct_specular, pix, vec4(direct_specular, direct_specular_history_samples));
	imageStore(out_temporal_asvgf_indirect_specular, pix, vec4(indirect_specular, indirect_specular_history_samples));
	imageStore(out_temporal_asvgf_direct_diffuse_stats, pix, encodeLuminanceStats(asvgf_direct_diffuse_stats));
	imageStore(out_temporal_asvgf_direct_specular_stats, pix, encodeLuminanceStats(asvgf_direct_specular_stats));
	imageStore(out_temporal_asvgf_indirect_diffuse_stats, pix, encodeLuminanceStats(asvgf_indirect_diffuse_stats));
	imageStore(out_temporal_asvgf_indirect_specular_stats, pix, encodeLuminanceStats(asvgf_indirect_specular_stats));

	vec2 asvgf_shading_normal = normalEncode(shading_normal);
	imageStore(out_temporal_asvgf_reproj_depth, pix, vec4(depth, current_roughness, asvgf_shading_normal.x, asvgf_shading_normal.y));
}
