#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_16bit_storage : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#define RAY_QUERY

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_lc_point_sh1;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D out_lc_point_sh2;

#include "lc_update_common.glsl"

vec3 pointRadiance(PointLight l, vec3 P, vec3 N, out vec3 L)
{
    L = vec3(0);
    vec3 axis;
    float omega;
    float distance = 10000.0;

    if (l.environment != 0u) {
        axis = normalize(l.dir_stopdot2.xyz);
        omega = 2.0 * kPi * max(1.0 - l.dir_stopdot2.w, 0.0);
    } else {
        vec3 d = l.origin_r2.xyz - P;
        float d2 = dot(d, d);
        if (d2 <= l.origin_r2.w || d2 < 1e-8)
            return vec3(0);

        distance = sqrt(d2);
        axis = d / distance;

        // Stable 1-sqrt(1-x), including small distant lights.
        float x = clamp(l.origin_r2.w / d2, 0.0, 1.0);
        omega = 2.0 * kPi * x / (1.0 + sqrt(1.0 - x));
    }

    // Deterministic center direction; retain the source's solid-angle intensity.
    L = axis;
    float spot = 1.0;
    if (l.environment == 0u && l.color_stopdot.w > l.dir_stopdot2.w)
        spot =
            // uploadPointLights already negates the source's emission direction.
            clamp((dot(L, l.dir_stopdot2.xyz) - l.dir_stopdot2.w) / (l.color_stopdot.w - l.dir_stopdot2.w), 0.0, 1.0);

    // Store incident lighting; apply the receiving normal only when sampling SH.
    vec3 c = l.color_stopdot.rgb * omega * spot;
    if (dot(N, L) <= 0.0 || lcWeight(c) == 0.0)
        return vec3(0);

    bool blocked = l.environment != 0u ? shadowedSky(P, L) : shadowed(P, L, distance);

    return blocked ? vec3(0) : c;
}

void updatePixel(ivec2 pix)
{
    ivec2 res = ivec2(LIGHTCACHE_SIDE);
    SH value = SH(vec4(0), vec2(0));
    uint index = lightcacheIndex(pix);

    if (lightcacheInCapacity(index, res) && !lightcacheUpdateDisabled()) {
        vec3 P, N;
        lightcacheSurface(index, P, N);

        uint cluster;
        if (lcLoadCluster(P, cluster)) {
            uint count = min(uint(light_grid.clusters_[cluster].num_point_lights), MAX_VISIBLE_POINT_LIGHTS);

            for (uint j = 0u; j < count; ++j) {
                uint id = uint(light_grid.clusters_[cluster].point_lights[j]);
                if (id >= lights.m.num_point_lights)
                    continue;

                vec3 L;
                vec3 radiance = pointRadiance(lights.m.point_lights[id], P, N, L);
                accumulate_SH(value, irradiance_to_SH(radiance, L), 1.0);
            }
        }
    }

    // Directional and chroma coefficients are signed.
    imageStore(out_lc_point_sh1, pix, clamp(value.shY, vec4(-65504), vec4(65504)));
    imageStore(out_lc_point_sh2, pix, vec4(clamp(value.CoCg, vec2(-65504), vec2(65504)), 0, 0));
}
