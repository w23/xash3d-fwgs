layout(set = 0, binding = 11, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 12, rgba8) uniform readonly image2D material_rmxx;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D base_color_a;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D out_indirect_specular;
layout(set = 0, binding = 23, rgba32f) uniform writeonly image2D out_reflection_direction_pdf;

// Reuse the existing primary-plane reprojection and local path ownership passes.
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 40, rgba32f) uniform readonly image2D prev_temporal_reflection_path_random;
layout(set = 0, binding = 41, rgba32f) uniform readonly image2D prev_temporal_reflection_path_reservoir;
layout(set = 0, binding = 42, rgba32f) uniform readonly image2D prev_reflection_hit_pos;
layout(set = 0, binding = 43, rgba32f) uniform writeonly image2D out_temporal_reflection_path_random;
layout(set = 0, binding = 44, rgba32f) uniform writeonly image2D out_temporal_reflection_path_reservoir;
layout(set = 0, binding = 45, rgba16f) uniform writeonly image2D out_temporal_reflection_path_normals;
layout(set = 0, binding = 46, rgba32f) uniform writeonly image2D out_reflection_hit_pos;
layout(set = 0, binding = 47, rgba32f) uniform readonly image2D prev_temporal_lc_reflection_hit_identity;
layout(set = 0, binding = 48, rgba32f) uniform writeonly image2D out_temporal_lc_reflection_hit_identity;
layout(set = 0, binding = 49, rgba16f) uniform readonly image2D prev_temporal_reflection_path_normals;
layout(set = 0, binding = 57, rgba32f) uniform readonly image2D prev_position_t;
layout(set = 0, binding = 58, rgba16f) uniform readonly image2D prev_normals_gs;
layout(set = 0, binding = 59, rgba32f) uniform writeonly image2D out_reflection_reuse_radiance;

