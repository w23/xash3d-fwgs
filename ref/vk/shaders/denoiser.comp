Components blurSamples(const ivec2 res, const ivec2 pix) {
	Components c;
	c.direct_diffuse = c.direct_specular = c.direct_flashlight_diffuse = c.direct_flashlight_specular = c.indirect_diffuse = c.indirect_specular = vec3(0.);
	c.direct_diffuse_confidence = 0.0;
	c.direct_specular_confidence = 0.0;
	c.indirect_specular_confidence = imageLoad(indirect_specular_reconstructed, pix / INDIRECT_SCALE).a;

	const vec4 center_pos = imageLoad(position_t, pix);

	const int KERNEL_SIZE = max(max(max(DIRECT_DIFFUSE_KERNEL, INDIRECT_DIFFUSE_KERNEL), DIRECT_SPECULAR_KERNEL), INDIRECT_SPECULAR_KERNEL);

	const float direct_diffuse_sigma = DIRECT_DIFFUSE_KERNEL / 2.;
	const float indirect_diffuse_sigma = INDIRECT_DIFFUSE_KERNEL / 2.;
	const float direct_specular_sigma = DIRECT_SPECULAR_KERNEL / 2.;
	const float indirect_specular_sigma = INDIRECT_SPECULAR_KERNEL / 2.;

	float direct_diffuse_total = 0.;
	float indirect_diffuse_total = 0.;
	float direct_specular_total = 0.;
	float indirect_specular_total = 0.;

	const ivec2 res_scaled = res / INDIRECT_SCALE;
	for (int x = -KERNEL_SIZE; x <= KERNEL_SIZE; ++x)
		for (int y = -KERNEL_SIZE; y <= KERNEL_SIZE; ++y) {
			const ivec2 p = pix + ivec2(x, y);
			if (any(greaterThanEqual(p, res)) || any(lessThan(p, ivec2(0)))) {
				continue;
			}

			vec3 sample_geometry_normal, sample_shading_normal;
			readNormals(p, sample_geometry_normal, sample_shading_normal);

			float scale = 1.f;
			// FIXME also filter by depth, (kusok index?), etc
			//scale *= smoothstep(.9, 1., dot(sample_geometry_normal, geometry_normal));

			const vec4 sample_pos = imageLoad(position_t, p);
			// FIXME what are these magic numbers?
			scale *= smoothstep(center_pos.w * 4. / 100., 0., distance(center_pos.xyz, sample_pos.xyz));

			if ( scale <= 0. )
				continue;

			const ivec2 p_indirect = pix / INDIRECT_SCALE + ivec2(x, y);
			const bool do_indirect = all(lessThan(p_indirect, res_scaled)) && all(greaterThanEqual(p_indirect, ivec2(0)));

			if (all(lessThan(abs(ivec2(x, y)), ivec2(DIRECT_DIFFUSE_KERNEL))))
			{
				const float direct_diffuse_scale = scale * normpdf(x, direct_diffuse_sigma) * normpdf(y, direct_diffuse_sigma);
				direct_diffuse_total += direct_diffuse_scale;

				c.direct_diffuse += imageLoad(light_point_diffuse, p).rgb * direct_diffuse_scale;
				c.direct_diffuse += imageLoad(light_poly_diffuse, p).rgb * direct_diffuse_scale;
				c.direct_flashlight_diffuse += imageLoad(light_point_flashlight_diffuse, p).rgb * direct_diffuse_scale;
			}

			if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DENOISE_GI_BY_SH) == 0 &&
				all(lessThan(abs(ivec2(x, y)), ivec2(INDIRECT_DIFFUSE_KERNEL))) && do_indirect)
			{
				// TODO indirect operates at different scale, do a separate pass
				const float indirect_diffuse_scale = scale
					* normpdf(x, indirect_diffuse_sigma)
					* normpdf(y, indirect_diffuse_sigma);

				indirect_diffuse_total += indirect_diffuse_scale;
				c.indirect_diffuse += imageLoad(indirect_diffuse, p_indirect).rgb * indirect_diffuse_scale;
			}

			if (all(lessThan(abs(ivec2(x, y)), ivec2(DIRECT_SPECULAR_KERNEL))))
			{
				const float specular_scale = scale * normpdf(x, direct_specular_sigma) * normpdf(y, direct_specular_sigma);
				direct_specular_total += specular_scale;

				c.direct_specular += imageLoad(light_poly_specular, p).rgb * specular_scale;
				DEBUG_VALIDATE_VEC3(c.direct_specular, "%d c.direct_specular=(%f,%f,%f) poly");

				c.direct_specular += imageLoad(light_point_specular, p).rgb * specular_scale;
				DEBUG_VALIDATE_VEC3(c.direct_specular, "%d c.direct_specular=(%f,%f,%f) point");
				c.direct_flashlight_specular += imageLoad(light_point_flashlight_specular, p).rgb * specular_scale;
			}

			if (all(lessThan(abs(ivec2(x, y)), ivec2(INDIRECT_SPECULAR_KERNEL)))) {
				const ivec2 p_indirect = (pix + ivec2(x, y)) / INDIRECT_SCALE;// + ivec2(x, y);
				const bool do_indirect = all(lessThan(p_indirect, res_scaled)) && all(greaterThanEqual(p_indirect, ivec2(0)));

				if (do_indirect) {
					// TODO indirect operates at different scale, do a separate pass
					const float specular_scale = scale * normpdf(x, indirect_specular_sigma) * normpdf(y, indirect_specular_sigma);
					indirect_specular_total += specular_scale;
					c.indirect_specular += imageLoad(indirect_specular_reconstructed, p_indirect).rgb * specular_scale;
				}
			}
		}

	if (direct_diffuse_total > 0.) {
		c.direct_diffuse /= direct_diffuse_total;
		c.direct_flashlight_diffuse /= direct_diffuse_total;
	}

	if (indirect_diffuse_total > 0.)
		c.indirect_diffuse *= indirect_diffuse_total;

#ifdef DEBUG_VALIDATE_EXTRA
	if (IS_INVALIDV(c.direct_specular)) {
		debugPrintfEXT("c.direct_specular=(%f,%f,%f)", PRIVEC3(c.direct_specular));
		c.direct_specular = vec3(0.);
	}

	if (IS_INVALID(direct_specular_total)) {
		debugPrintfEXT("direct_specular_total=%f", direct_specular_total);
		direct_specular_total = 0.;
	}
#endif

	if (direct_specular_total > 0.) {
		c.direct_specular *= direct_specular_total;
		c.direct_flashlight_specular *= direct_specular_total;
	}

	if (indirect_specular_total > 0.)
		c.indirect_specular *= indirect_specular_total;

#ifdef DEBUG_VALIDATE_EXTRA
	if (IS_INVALIDV(c.indirect_specular)) {
		debugPrintfEXT("c.indirect_specular=(%f,%f,%f)", PRIVEC3(c.indirect_specular));
		c.indirect_specular = vec3(0.);
	}
#endif

	return c;
}

void main() {
	const ivec2 res = ubo.ubo.res;
	const ivec2 pix = ivec2(gl_GlobalInvocationID);

	if (any(greaterThanEqual(pix, res))) {
		return;
	}

	const vec3 position = imageLoad(position_t, pix).xyz;

	const vec3 base_color = SRGBtoLINEAR(imageLoad(base_color_a, pix).rgb);
	const float metalness = imageLoad(material_rmxx, pix).g;

	vec3 geometry_normal, shading_normal;
	readNormals(pix, geometry_normal, shading_normal);

	if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DISABLED) {
		// no-op, just continue
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_BASECOLOR) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(imageLoad(base_color_a, pix).rgb), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_BASEALPHA) {
		imageStore(out_dest, pix, imageLoad(base_color_a, pix).aaaa); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_EMISSIVE) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(imageLoad(emissive, pix).rgb), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_MATERIAL) {
		imageStore(out_dest, pix, vec4(imageLoad(material_rmxx, pix).rg, 0., 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_NSHADE) {
		imageStore(out_dest, pix, vec4(.5 + shading_normal * .5, 0.));
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_NGEOM) {
		imageStore(out_dest, pix, vec4(.5 + geometry_normal * .5, 0.));
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_CONFIDENCE) {
		vec2 polygon_confidence = imageLoad(light_polygon_confidence, pix).rg;
		vec2 point_confidence = imageLoad(light_point_confidence, pix).rg;
		vec2 confidence = min(polygon_confidence, point_confidence);
		float indirect_specular_confidence = imageLoad(indirect_specular_reconstructed, pix / INDIRECT_SCALE).a;
		imageStore(out_dest, pix, vec4(confidence.r, confidence.g, indirect_specular_confidence, 0.0));
		return;
	}

#ifdef DEBUG_NOISE
	imageStore(out_dest, pix, blueNoise(ivec3(pix.xy, ubo.ubo.frame_counter))); return;
#endif

	//const Components c = blurSamples(res, pix);
	//const Components c = boxBlurSamples(res, pix);
	//const Components c = dontBlurSamples(res, pix);
	const Components c = blurATrous(res, pix, position, shading_normal, geometry_normal, base_color, metalness);

	if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DISABLED) {
		// Skip
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.direct_diffuse + c.direct_specular + c.direct_flashlight_diffuse + c.direct_flashlight_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT_DIFF) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.direct_diffuse + c.direct_flashlight_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT_SPEC) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.direct_specular + c.direct_flashlight_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.indirect_diffuse + c.indirect_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT_SPEC) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.indirect_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT_DIFF) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.indirect_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIFFUSE) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.indirect_diffuse + c.direct_diffuse + c.direct_flashlight_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_SPECULAR) {
		imageStore(out_dest, pix, vec4(LINEARtoSRGB(c.indirect_specular + c.direct_specular + c.direct_flashlight_specular), 0.)); return;
		return;
	}

	vec3 diffuse = c.direct_diffuse + c.indirect_diffuse;
	vec3 specular = c.direct_specular + restoreSpecular(c.indirect_specular, base_color, metalness);
	const vec3 flashlight_diffuse = c.direct_flashlight_diffuse;
	const vec3 flashlight_specular = c.direct_flashlight_specular;
	const float direct_diffuse_confidence = clamp(c.direct_diffuse_confidence, 0.0, 1.0);
	const float direct_specular_confidence = clamp(c.direct_specular_confidence, 0.0, 1.0);
	const float indirect_specular_confidence = clamp(c.indirect_specular_confidence, 0.0, 1.0);

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DENOISE_GI_BY_SH) != 0) {
		diffuse += imageLoad(indirect_diffuse_denoised_by_sh, pix).rgb;
	}

	{
//#define DISABLE_TEMPORAL_DENOISER
#ifndef DISABLE_TEMPORAL_DENOISER
		// TODO: need to extract reprojecting from this shader because reprojected stuff need svgf denoising pass after it
		const vec3 origin = (ubo.ubo.inv_view * vec4(0., 0., 0., 1.)).xyz;
		const float depth = length(origin - position);
		const vec3 prev_position = imageLoad(geometry_prev_position, pix).rgb;
		ivec2 reproj_pix = ivec2(-1);
		float depth_nessesary = 0.0;
		float depth_treshold = 0.0;
		reprojectToPrevFramePixel(prev_position, res, reproj_pix, depth_nessesary, depth_treshold);
		const vec3 prev_origin = (ubo.ubo.prev_inv_view * vec4(0., 0., 0., 1.)).xyz;
		float better_depth_offset = depth_treshold;
		vec3 history_diffuse = diffuse;
		vec3 direct_specular = c.direct_specular;
		vec3 indirect_specular = c.indirect_specular;
		vec3 history_direct_specular = direct_specular;
		vec3 history_indirect_specular = indirect_specular;
		float diffuse_history_samples = 1.0;
		float direct_specular_history_samples = 1.0;
		float indirect_specular_history_samples = 1.0;
		float diffuse_confidence = 0.0;
		float direct_specular_confidence_temporal = 0.0;
		float indirect_specular_confidence_temporal = 0.0;
		float diffuse_variance_confidence = 1.0;
		float direct_specular_variance_confidence = 1.0;
		float indirect_specular_variance_confidence = 1.0;
		float direct_specular_history_outlier = 0.0;
		float direct_specular_history_luma_cap = DIRECT_SPECULAR_FALLBACK_HISTORY_LUMA_CLAMP;
		float direct_specular_noise_gate = 0.0;
		const LuminanceStats current_diffuse_stats = sampleCurrentDiffuseStats3x3(pix, res);
		const LuminanceStats current_direct_specular_stats = sampleCurrentDirectSpecularStats3x3(pix, res);
		const LuminanceStats current_indirect_specular_stats = sampleCurrentIndirectSpecularStats3x3(pix, res);
		LuminanceStats history_diffuse_stats = current_diffuse_stats;
		LuminanceStats history_direct_specular_stats = current_direct_specular_stats;
		LuminanceStats history_indirect_specular_stats = current_indirect_specular_stats;
		const float current_diffuse_luma = luminance(diffuse);
		const float current_direct_specular_luma = luminance(direct_specular);
		const float current_indirect_specular_luma = luminance(indirect_specular);
		const float current_roughness = imageLoad(material_rmxx, pix).x;
		
		if (all(greaterThanEqual(reproj_pix, ivec2(0))) && all(lessThan(reproj_pix, res))) {			
			const vec4 history_diffuse_sample = imageLoad(prev_temporal_diffuse, reproj_pix);

			const float history_depth = imageLoad(prev_temporal_reproj_depth, reproj_pix).r;
			const float depth_offset = abs(history_depth - depth_nessesary);
			if ( depth_offset < better_depth_offset ) {
				better_depth_offset = depth_offset;
				history_diffuse = history_diffuse_sample.rgb;
				diffuse_history_samples = max(history_diffuse_sample.a, 0.0);
				diffuse_confidence = direct_diffuse_confidence;
				history_diffuse_stats = sampleHistoryStats3x3(false, reproj_pix, res);
				diffuse_variance_confidence = computeVarianceConfidence(current_diffuse_luma, current_diffuse_stats, luminance(history_diffuse), history_diffuse_stats);
			}
		}

		bool has_base_history = better_depth_offset < depth_treshold;

		// parallax reprojecting for direct specular
		const float average_ray_length = sampleAverageReflectionRayLength(pix, res, INDIRECT_SCALE, 1);
		ivec2 parallax_pix = ivec2(-1);
		bool has_direct_specular_reprojection = parallaxReprojectToPrevFramePixel(position, prev_position, geometry_normal, origin, prev_origin, average_ray_length, res, parallax_pix) && all(greaterThanEqual(parallax_pix, ivec2(0))) && all(lessThan(parallax_pix, res));
		bool use_direct_specular_parallax = false;
		ivec2 direct_specular_history_pix = reproj_pix;
		if (has_base_history && has_direct_specular_reprojection) {
			vec4 parallax_history_meta = imageLoad(prev_temporal_reproj_depth, parallax_pix);
			float parallax_plane_depth = 0.0;
			bool has_parallax_plane_depth = computePlaneDepthInPrevFrame(parallax_pix, res, position, geometry_normal, parallax_plane_depth);
			if (has_parallax_plane_depth) {
				float parallax_depth_offset = abs(parallax_history_meta.r - parallax_plane_depth);
				vec3 parallax_prev_shading_normal = normalDecode(parallax_history_meta.ba);
				float parallax_normal_delta = 1.0 - saturate(dot(shading_normal, parallax_prev_shading_normal));
				float parallax_roughness_delta = abs(parallax_history_meta.g - current_roughness);
				float parallax_normal_match = 1.0 - smoothstep(TEMPORAL_PARALLAX_SHADING_NORMAL_THRESHOLD, TEMPORAL_PARALLAX_SHADING_NORMAL_THRESHOLD * 2.0, parallax_normal_delta);
				float parallax_roughness_match = 1.0 - smoothstep(TEMPORAL_PARALLAX_ROUGHNESS_THRESHOLD, TEMPORAL_PARALLAX_ROUGHNESS_THRESHOLD * 2.0, parallax_roughness_delta);
				use_direct_specular_parallax = (parallax_depth_offset < depth_treshold) && (parallax_normal_match > 0.0) && (parallax_roughness_match > 0.0);
			}
		}
		if (has_base_history) {
			if (use_direct_specular_parallax) {
				direct_specular_history_pix = parallax_pix;
			}
			const vec4 history_direct_specular_sample = imageLoad(prev_temporal_specular, direct_specular_history_pix);
			history_direct_specular = history_direct_specular_sample.xyz;
			if (!use_direct_specular_parallax) {
				history_direct_specular = clampSpecularLuminance(history_direct_specular, DIRECT_SPECULAR_FALLBACK_HISTORY_LUMA_CLAMP);
			}
			direct_specular_history_samples = max(history_direct_specular_sample.a, 0.0);
			direct_specular_confidence_temporal = direct_specular_confidence;
			history_direct_specular_stats = sampleHistoryStats3x3(true, direct_specular_history_pix, res);
			direct_specular_variance_confidence = computeVarianceConfidence(current_direct_specular_luma, current_direct_specular_stats, luminance(history_direct_specular), history_direct_specular_stats);
			float current_direct_sigma = sqrt(max(current_direct_specular_stats.variance, 0.0));
			float direct_noise_norm = current_direct_sigma / (current_direct_specular_stats.mean + 0.05);
			direct_specular_noise_gate = smoothstep(0.08, 0.45, direct_noise_norm);
			float direct_envelope_sigma_scale = mix(2.5, 5.5, direct_specular_noise_gate);
			float direct_envelope_mean_scale = mix(0.15, 0.45, direct_specular_noise_gate);
			float direct_history_envelope = max(current_direct_sigma * direct_envelope_sigma_scale + direct_envelope_mean_scale * current_direct_specular_stats.mean, 0.03);
			float direct_history_delta = abs(luminance(history_direct_specular) - current_direct_specular_stats.mean);
			float direct_outlier_lo = mix(1.0, 1.4, direct_specular_noise_gate);
			float direct_outlier_hi = mix(2.5, 4.2, direct_specular_noise_gate);
			direct_specular_history_outlier = smoothstep(direct_outlier_lo, direct_outlier_hi, direct_history_delta / direct_history_envelope);
			direct_specular_history_luma_cap = max(current_direct_specular_stats.mean + direct_history_envelope * mix(1.0, 1.6, direct_specular_noise_gate), DIRECT_SPECULAR_FALLBACK_HISTORY_LUMA_CLAMP);
			if (direct_specular_history_outlier > 0.0) {
				history_direct_specular = clampSpecularLuminance(history_direct_specular, direct_specular_history_luma_cap);
			}
			float direct_confidence_attenuation = mix(0.85, 0.35, direct_specular_noise_gate);
			direct_specular_confidence_temporal *= (1.0 - direct_confidence_attenuation * direct_specular_history_outlier);
		}

		// parallax reprojecting for indirect specular
		ivec2 indirect_parallax_pix = ivec2(-1);
		bool has_indirect_specular_reprojection = parallaxReprojectToPrevFramePixel(position, prev_position, geometry_normal, origin, prev_origin, average_ray_length, res, indirect_parallax_pix) && all(greaterThanEqual(indirect_parallax_pix, ivec2(0))) && all(lessThan(indirect_parallax_pix, res));
		bool use_indirect_specular_parallax = false;
		ivec2 indirect_specular_history_pix = reproj_pix;
		if (has_base_history && has_indirect_specular_reprojection) {
			vec4 parallax_history_meta = imageLoad(prev_temporal_reproj_depth, indirect_parallax_pix);
			float parallax_plane_depth = 0.0;
			bool has_parallax_plane_depth = computePlaneDepthInPrevFrame(indirect_parallax_pix, res, position, geometry_normal, parallax_plane_depth);
			if (has_parallax_plane_depth) {
				float parallax_depth_offset = abs(parallax_history_meta.r - parallax_plane_depth);
				vec3 parallax_prev_shading_normal = normalDecode(parallax_history_meta.ba);
				float parallax_normal_delta = 1.0 - saturate(dot(shading_normal, parallax_prev_shading_normal));
				float parallax_roughness_delta = abs(parallax_history_meta.g - current_roughness);
				float parallax_normal_match = 1.0 - smoothstep(TEMPORAL_PARALLAX_SHADING_NORMAL_THRESHOLD, TEMPORAL_PARALLAX_SHADING_NORMAL_THRESHOLD * 2.0, parallax_normal_delta);
				float parallax_roughness_match = 1.0 - smoothstep(TEMPORAL_PARALLAX_ROUGHNESS_THRESHOLD, TEMPORAL_PARALLAX_ROUGHNESS_THRESHOLD * 2.0, parallax_roughness_delta);
				use_indirect_specular_parallax = (parallax_depth_offset < depth_treshold) && (parallax_normal_match > 0.0) && (parallax_roughness_match > 0.0);
			}
		}
		if (has_base_history) {
			if (use_indirect_specular_parallax) {
				indirect_specular_history_pix = indirect_parallax_pix;
			}
			const vec4 history_indirect_specular_sample = imageLoad(prev_temporal_indirect_specular, indirect_specular_history_pix);
			history_indirect_specular = history_indirect_specular_sample.xyz;
			indirect_specular_history_samples = max(history_indirect_specular_sample.a, 0.0);
			indirect_specular_confidence_temporal = indirect_specular_confidence;
			history_indirect_specular_stats = sampleHistoryIndirectSpecularStats3x3(indirect_specular_history_pix, res);
			indirect_specular_variance_confidence = computeVarianceConfidence(current_indirect_specular_luma, current_indirect_specular_stats, luminance(history_indirect_specular), history_indirect_specular_stats);
		}
#ifdef DEBUG_VALIDATE_EXTRA
		if (IS_INVALIDV(history_direct_specular)) {
			debugPrintfEXT("PRE pix=(%d,%d) history_direct_specular=inv", pix.x, pix.y);
			history_direct_specular = vec3(0.);
		}

		if (IS_INVALIDV(specular)) {
			debugPrintfEXT("PRE pix=(%d,%d) specular=(%f,%f,%f)", pix.x, pix.y, PRIVEC3(specular));
			specular = vec3(0.);
		}
#endif
		bool has_diffuse_history = has_base_history;
		bool has_direct_specular_history = has_base_history;
		bool has_indirect_specular_history = has_base_history;

		if (has_diffuse_history) {
			float diffuse_variance_gate = computeVarianceGate(current_diffuse_stats, history_diffuse_stats);
			float diffuse_reset_factor = diffuse_confidence * softenVarianceConfidence(diffuse_variance_confidence);
			diffuse_reset_factor = applyVarianceSoftReset(diffuse_reset_factor, diffuse_variance_gate, 0.22);
			vec4 accumulated_diffuse = accumulateTemporalRadiance(diffuse, history_diffuse, diffuse_history_samples, diffuse_reset_factor);
			diffuse = accumulated_diffuse.rgb;
			diffuse_history_samples = accumulated_diffuse.a;
		} else {
			diffuse_history_samples = 0.0;
		}

		if (has_direct_specular_history) {
			float direct_specular_variance_gate = computeVarianceGate(current_direct_specular_stats, history_direct_specular_stats);
			float direct_specular_reset_factor = direct_specular_confidence_temporal * mix(1.0, softenVarianceConfidence(direct_specular_variance_confidence), 0.65);
			direct_specular_reset_factor *= mix(1.0, mix(0.15, 0.55, direct_specular_noise_gate), direct_specular_history_outlier);
			direct_specular_reset_factor = applyVarianceSoftReset(direct_specular_reset_factor, direct_specular_variance_gate, 0.18);
			vec4 accumulated_direct_specular = accumulateTemporalRadiance(direct_specular, history_direct_specular, direct_specular_history_samples, direct_specular_reset_factor);
			direct_specular = accumulated_direct_specular.rgb;
			if (direct_specular_history_outlier > 0.0) {
				direct_specular = clampSpecularLuminance(direct_specular, direct_specular_history_luma_cap * mix(1.1, 1.45, direct_specular_noise_gate));
			}
			direct_specular_history_samples = accumulated_direct_specular.a;
		} else {
			direct_specular_history_samples = 0.0;
		}

		if (has_indirect_specular_history) {
			float indirect_specular_variance_gate = mix(0.35, 1.0, computeVarianceGate(current_indirect_specular_stats, history_indirect_specular_stats));
			float indirect_specular_reset_factor = indirect_specular_confidence_temporal * mix(1.0, softenVarianceConfidence(indirect_specular_variance_confidence), 0.45);
			indirect_specular_reset_factor = applyVarianceSoftReset(indirect_specular_reset_factor, indirect_specular_variance_gate, 0.30);
			vec4 accumulated_indirect_specular = accumulateTemporalRadiance(indirect_specular, history_indirect_specular, indirect_specular_history_samples, indirect_specular_reset_factor);
			indirect_specular = accumulated_indirect_specular.rgb;
			indirect_specular_history_samples = accumulated_indirect_specular.a;
		} else {
			indirect_specular_history_samples = 0.0;
		}

		specular = direct_specular + restoreSpecular(indirect_specular, base_color, metalness);

#ifdef DEBUG_VALIDATE_EXTRA
		if (IS_INVALIDV(diffuse)) {
			debugPrintfEXT("pix=(%d,%d) diffuse=inv", pix.x, pix.y);
			diffuse = vec3(0.);
		}

		if (IS_INVALIDV(specular)) {
			debugPrintfEXT("pix=(%d,%d) new_specular=inv, specular=(%f, %f, %f) history_direct_specular=(%f, %f, %f)",
				pix.x, pix.y,
				specular.r, specular.g, specular.b,
				history_direct_specular.r, history_direct_specular.g, history_direct_specular.b
				);
			specular = vec3(0.);
		}
#endif

		DEBUG_VALIDATE_RANGE_VEC3("denoiser.diffuse", diffuse, 0., 1e6);
		DEBUG_VALIDATE_RANGE_VEC3("denoiser.specular", specular, 0., 1e6);

		imageStore(out_temporal_diffuse, pix, vec4(diffuse, diffuse_history_samples));
		imageStore(out_temporal_specular, pix, vec4(direct_specular, direct_specular_history_samples));
		imageStore(out_temporal_indirect_specular, pix, vec4(indirect_specular, indirect_specular_history_samples));
		vec2 temporal_shading_normal = normalEncode(shading_normal);
		imageStore(out_temporal_reproj_depth, pix, vec4(depth, current_roughness, temporal_shading_normal.x, temporal_shading_normal.y));
#endif // ifndef DISABLE_TEMPORAL_DENOISER
	}


	diffuse += flashlight_diffuse;
	specular += flashlight_specular;

	vec3 colour = vec3(0.);

	if (ubo.ubo.debug_display_only != DEBUG_DISPLAY_LIGHTING) {
		colour = mixFinalColor(base_color, diffuse, specular, metalness);
	} else {
		colour = diffuse + specular;
	}

	const vec4 legacy_blend = imageLoad(legacy_blend, pix);

	colour += imageLoad(emissive, pix).rgb;
	// Revealage. TODO: which colorspace?
	colour *= legacy_blend.a;

	colour = LINEARtoSRGB(colour);

// See issue https://github.com/w23/xash3d-fwgs/issues/668, map test_blendmode_additive_alpha.
// Adding emissive_blend to the final color in the incorrect sRGB space. It makes
// it look much more like the original. Adding emissive in the *correct* linear space differs
// from the original a lot, and looks perceptively worse.
	colour += legacy_blend.rgb;

	DEBUG_VALIDATE_RANGE_VEC3("denoiser.colour", colour, 0., 1e6);

	imageStore(out_dest, pix, vec4(colour, 0./*unused*/));
}
































