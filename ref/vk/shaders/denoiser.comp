	c.direct_diffuse_confidence = clamp(c.direct_diffuse_confidence, 0.0, 1.0);
	if (weight_total_specular <= 0.0) { c.direct_specular_confidence = center_direct_confidence.y; }
	c.direct_specular_confidence = clamp(c.direct_specular_confidence, 0.0, 1.0);

