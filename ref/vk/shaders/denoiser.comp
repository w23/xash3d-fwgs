vec3 clampSpecularLuminance(vec3 specular, float max_luminance) {
	float lum = luminance(specular);
	if (lum <= 0.0) {
		return vec3(0.0);
	}
	float clamped = min(max_luminance, lum);
	return specular * (clamped / lum);
}

float computeVarianceConfidence(float current_luma, LuminanceStats current_stats, float history_luma, LuminanceStats history_stats) {
	float expected_sigma = sqrt(max(max(current_stats.variance, history_stats.variance), 0.0));
	float expected_delta = max(expected_sigma + 0.1 * max(current_stats.mean, history_stats.mean), 0.02);
	float mismatch = max(abs(current_luma - history_luma), abs(current_stats.mean - history_stats.mean)) / expected_delta;
	return 1.0 - smoothstep(2.0, 6.0, mismatch);
}

float softenVarianceConfidence(float confidence) {
	if (confidence <= 0.2) {
		return 0.0;
	}
	return mix(1.0, confidence, 0.35);
}

float computeVarianceGate(LuminanceStats current_stats, LuminanceStats history_stats) {
	float current_sigma = sqrt(max(current_stats.variance, 0.0));
	float history_sigma = sqrt(max(history_stats.variance, 0.0));
	float sigma = max(current_sigma, history_sigma);
	float signal = max(max(current_stats.mean, history_stats.mean), 0.02);
	float normalized_sigma = sigma / (signal + 1e-4);
	return smoothstep(0.04, 0.35, normalized_sigma);
}

float applyVarianceSoftReset(float reset_factor, float variance_gate, float min_reset_scale) {
	float gate = clamp(variance_gate, 0.0, 1.0);
	float scaled_reset = reset_factor * mix(min_reset_scale, 1.0, gate);
	return clamp(scaled_reset, 0.0, 1.0);
}

vec4 accumulateTemporalRadiance(vec3 current, vec3 history, float history_samples, float reset_factor) {
	float clamped_reset_factor = clamp(reset_factor, 0.0, 1.0);
	float max_effective_history_samples = min(
		TEMPORAL_HISTORY_SAMPLES_MAX - 1.0,
		(1.0 / TEMPORAL_HISTORY_CURRENT_WEIGHT_MIN) - 1.0);
	float effective_history_samples = min(max(history_samples, 0.0) * clamped_reset_factor, max_effective_history_samples);
	float total_samples = effective_history_samples + 1.0;
	float history_mix = effective_history_samples / total_samples;
	vec3 accumulated = mix(current, history, history_mix);
	return vec4(accumulated, min(total_samples, TEMPORAL_HISTORY_SAMPLES_MAX));
}


struct Components {
	vec3 direct_diffuse, direct_specular, direct_flashlight_diffuse, direct_flashlight_specular, indirect_diffuse, indirect_specular;
	float direct_diffuse_confidence;
	float direct_specular_confidence;
	float indirect_specular_confidence;
};

Components dontBlurSamples(const ivec2 res, const ivec2 pix) {
	Components c;
	c.direct_diffuse = c.direct_specular = c.direct_flashlight_diffuse = c.direct_flashlight_specular = c.indirect_diffuse = c.indirect_specular = vec3(0.);
	c.direct_diffuse_confidence = 0.0;
	c.direct_specular_confidence = 0.0;
	c.indirect_specular_confidence = 0.0;
	const ivec2 p = pix;
	const ivec2 p_indirect = pix / INDIRECT_SCALE;
	c.direct_diffuse += imageLoad(light_point_diffuse, p).rgb;
	c.direct_diffuse += imageLoad(light_poly_diffuse, p).rgb;
	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DENOISE_GI_BY_SH) == 0) {
	c.indirect_diffuse += imageLoad(indirect_diffuse, p_indirect).rgb;
	} else {
		c.indirect_diffuse += imageLoad(indirect_diffuse_denoised_by_sh, p).rgb;
	}
	c.direct_specular += imageLoad(light_poly_specular, p).rgb;
	c.direct_specular += imageLoad(light_point_specular, p).rgb;
	c.direct_flashlight_diffuse += imageLoad(light_point_flashlight_diffuse, p).rgb;
	c.direct_flashlight_specular += imageLoad(light_point_flashlight_specular, p).rgb;
	vec2 direct_confidence = min(imageLoad(light_polygon_confidence, p).rg, imageLoad(light_point_confidence, p).rg);
	c.direct_diffuse_confidence = direct_confidence.x;
	c.direct_specular_confidence = direct_confidence.y;
	c.indirect_specular += imageLoad(indirect_specular_reconstructed, p_indirect).rgb;
	c.indirect_specular_confidence = imageLoad(indirect_specular_reconstructed, p_indirect).a;
	return c;
}

#define BOX_BLUR(out, tex, res, center, kernel_range) \
{ \
	const float scale = 1. / pow(float(kernel_range * 2 + 1), 2.); \
	for (int x = -kernel_range; x <= kernel_range; ++x) { \
		for (int y = -kernel_range; y <= kernel_range; ++y) { \
			const ivec2 p = center + ivec2(x, y); \
			if (any(greaterThanEqual(p, res)) || any(lessThan(p, ivec2(0)))) \
				continue; \
			out += imageLoad(tex, p).rgb * scale; \
		} /* for y */ \
	} /* for x */ \
}

#if 1
	const int DIRECT_DIFFUSE_KERNEL = 3;
	const int DIRECT_SPECULAR_KERNEL = 2;
	const int INDIRECT_DIFFUSE_KERNEL = 5;
	const int INDIRECT_SPECULAR_KERNEL = 2;
#else
	const int DIRECT_DIFFUSE_KERNEL = 1;
	const int DIRECT_SPECULAR_KERNEL = 1;
	const int INDIRECT_DIFFUSE_KERNEL = 1;
	const int INDIRECT_SPECULAR_KERNEL = 1;
#endif

Components boxBlurSamples(ivec2 res, ivec2 pix) {
	Components c;
	c.direct_diffuse = c.direct_specular = c.direct_flashlight_diffuse = c.direct_flashlight_specular = c.indirect_diffuse = c.indirect_specular = vec3(0.);
	c.direct_diffuse_confidence = 0.0;
	c.direct_specular_confidence = 0.0;
	c.indirect_specular_confidence = imageLoad(indirect_specular_reconstructed, pix / INDIRECT_SCALE).a;

	BOX_BLUR(c.direct_diffuse, light_poly_diffuse, res, pix, DIRECT_DIFFUSE_KERNEL);
	BOX_BLUR(c.direct_diffuse, light_point_diffuse, res, pix, DIRECT_DIFFUSE_KERNEL);

	BOX_BLUR(c.direct_specular, light_poly_specular, res, pix, DIRECT_SPECULAR_KERNEL);
	BOX_BLUR(c.direct_specular, light_point_specular, res, pix, DIRECT_SPECULAR_KERNEL);
	BOX_BLUR(c.direct_flashlight_diffuse, light_point_flashlight_diffuse, res, pix, DIRECT_DIFFUSE_KERNEL);
	BOX_BLUR(c.direct_flashlight_specular, light_point_flashlight_specular, res, pix, DIRECT_SPECULAR_KERNEL);

	res /= 2;
	pix /= 2;
	
	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DENOISE_GI_BY_SH) == 0) {
	BOX_BLUR(c.indirect_diffuse, indirect_diffuse, res, pix, INDIRECT_DIFFUSE_KERNEL);
	}

	BOX_BLUR(c.indirect_specular, indirect_specular_reconstructed, res, pix, INDIRECT_SPECULAR_KERNEL);

	return c;
}

vec3 restoreSpecular(vec3 decolorized_specular, vec3 base_color, float metalness) {
	// TODO: add fresnel and do like PBR
	const vec3 plasticSpecular = decolorized_specular * DIELECTRIC_SPECULAR_MULTIPLIER;
	const vec3 metalSpecular = decolorized_specular * base_color;
	return mix(plasticSpecular, metalSpecular, metalness);
}

Components blurATrous(const ivec2 res, const ivec2 pix, vec3 pos, vec3 shading_normal, vec3 geometry_normal, vec3 base_color, float metalness) {
	Components c;
	c.direct_diffuse = c.direct_specular = c.direct_flashlight_diffuse = c.direct_flashlight_specular = c.indirect_diffuse = c.indirect_specular = vec3(0.);
	c.direct_diffuse_confidence = 0.0;
	c.direct_specular_confidence = 0.0;
	c.indirect_specular_confidence = 0.0;

	float weight_total_diffuse = 0.;
	float weight_total_specular = 0.;
	float weight_total_indirect_diffuse = 0.;
	float weight_total_indirect_specular = 0.;
	vec3 indirect_diffuse_c2 = vec3(0.);
	const ivec2 res_scaled = res / INDIRECT_SCALE;
	const vec2 center_direct_confidence = min(imageLoad(light_polygon_confidence, pix).rg, imageLoad(light_point_confidence, pix).rg);
	const float center_indirect_specular_confidence = imageLoad(indirect_specular_reconstructed, pix / INDIRECT_SCALE).a;
	for (int x = 0; x <= ATROUS_KERNEL_WIDTH; ++x) {
		for (int y = 0; y <= ATROUS_KERNEL_WIDTH; ++y) {
			const ivec2 offset = ivec2(x, y);
			// 1. Direct diffuse
			{
				const float sn_phi = .5;
				const float p_phi = 2.;
				const int step_width = 3;
				ivec2 p;
				const float weight = aTrousSampleWeigth(
					res, pix, pos, shading_normal, offset, step_width, 1, sn_phi, p_phi, p);

				if (weight > 0.) {
					vec2 sample_direct_confidence = min(imageLoad(light_polygon_confidence, p).rg, imageLoad(light_point_confidence, p).rg);
					weight_total_diffuse += weight;
					c.direct_diffuse +=
						(imageLoad(light_poly_diffuse, p).rgb
						+imageLoad(light_point_diffuse, p).rgb) * weight;
					c.direct_flashlight_diffuse += imageLoad(light_point_flashlight_diffuse, p).rgb * weight;
					c.direct_diffuse_confidence += sample_direct_confidence.x * weight;
				}
			}

			// 2. Direct specular
			{
				const float sn_phi = .5;
				const float p_phi = 1.;
				const int step_width = 1;
				ivec2 p;
				const float weight = aTrousSampleWeigth(
					res, pix, pos, shading_normal, offset, step_width, 1, sn_phi, p_phi, p);

				if (weight > 0.) {
					vec2 sample_direct_confidence = min(imageLoad(light_polygon_confidence, p).rg, imageLoad(light_point_confidence, p).rg);
					weight_total_specular += weight;
					c.direct_specular +=
						(imageLoad(light_poly_specular, p).rgb
						+imageLoad(light_point_specular, p).rgb) * weight;
					c.direct_flashlight_specular += imageLoad(light_point_flashlight_specular, p).rgb * weight;
					c.direct_specular_confidence += sample_direct_confidence.y * weight;
				}
			}

			// 3. Indirect diffuse
			{
				const float sn_phi = .5;
				const float p_phi = 3.;
				const int step_width = 2;
				ivec2 p;
				const float weight = aTrousSampleWeigth(
					res, pix, pos, shading_normal, offset, step_width, 1, sn_phi, p_phi, p);

				if (weight > 0.) {
					const ivec2 p_scaled = p / INDIRECT_SCALE;
					const bool do_indirect = all(lessThan(p_scaled, res_scaled));
					if (do_indirect) {
						weight_total_indirect_diffuse += weight;
						indirect_diffuse_c2 += imageLoad(indirect_diffuse_atrous1, p_scaled).rgb * weight;
					}
				}
			}

