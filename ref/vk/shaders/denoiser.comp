				const float sn_phi = .5;
				const float p_phi = 1.;
				const int step_width = 1;
				ivec2 p;
				const float weight = aTrousSampleWeigth(
					res, pix, pos, shading_normal, offset, step_width, 1, sn_phi, p_phi, p);

				if (weight > 0.) {
					const ivec2 p_scaled = p / INDIRECT_SCALE;
					const bool do_indirect = all(lessThan(p_scaled, res_scaled));
					if (do_indirect) {
						const vec4 sample_indirect_specular = imageLoad(indirect_specular_reconstructed, p_scaled);
						const float sample_confidence = sample_indirect_specular.a;
						const float confidence_delta = abs(sample_confidence - center_indirect_specular_confidence);
						const float confidence_edge = 1.0 - smoothstep(0.04, 0.25, confidence_delta);
						const float combined_weight = weight * confidence_edge;
						if (combined_weight > 0.0) {
							weight_total_indirect_specular += combined_weight;
							c.indirect_specular += sample_indirect_specular.rgb * combined_weight;
							c.indirect_specular_confidence += sample_confidence * combined_weight;
						}
					}
				}
			}
