#version 460
#include "debug.glsl"
#include "utils.glsl"
#include "color_spaces.glsl"
#define GLSL
#include "ray_interop.h"
#undef GLSL

// Composition only: each lighting lobe is denoised by its own producer.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D out_hdr_composed;
layout(set = 0, binding = 1) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 2, rgba8) uniform readonly image2D base_color_a;
layout(set = 0, binding = 3, rgba8) uniform readonly image2D material_rmxx;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D emissive;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D legacy_blend;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D direct_diffuse;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D direct_specular;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D indirect_diffuse_denoised_by_sh;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D temporal_indirect_specular;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D heitz_noise_blurred;
layout(set = 0, binding = 12, rgba32f) uniform image2D out_temporal_exposure;
layout(set = 0, binding = 13, rgba32f) uniform readonly image2D prev_temporal_exposure;

vec4 loadExposureTemporalData(ivec2 pix) {
	return imageLoad(prev_temporal_exposure, pix);
}

void storeExposureTemporalData(ivec2 pix, vec4 value) {
	imageStore(out_temporal_exposure, pix, value);
}

#include "auto_exposure.glsl"
#include "bloom_config.glsl"

layout(set = 0, binding = 14, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 15, rgba16f) uniform writeonly image2D out_bloom_a;

layout(set = 0, binding = 16, rgba16f) uniform readonly image2D refraction;

struct Components {
    vec3 direct_diffuse, direct_specular, indirect_diffuse, indirect_specular;
};
void readNormals(ivec2 pix, out vec3 geometry_normal, out vec3 shading_normal) {
    vec4 n = imageLoad(normals_gs, pix);
    geometry_normal = normalDecode(n.xy);
    shading_normal = normalDecode(n.zw);
}
vec3 restoreSpecular(vec3 value, vec3 base_color, float metalness) {
    return value * mix(vec3(0.02), base_color, metalness);
}

void main() {
	const ivec2 res = ubo.ubo.res;
	const ivec2 pix = ivec2(gl_GlobalInvocationID);

	if (any(greaterThanEqual(pix, res))) {
		// Auto-exposure barriers run only in full 8x8 workgroups.
		return;
	}

	imageStore(out_bloom_a, pix, vec4(0.0));

	const vec3 base_color = SRGBtoLINEAR(imageLoad(base_color_a, pix).rgb);
	const float metalness = imageLoad(material_rmxx, pix).g;

	vec3 geometry_normal, shading_normal;
	readNormals(pix, geometry_normal, shading_normal);

	if (bloomDisplay(ubo.ubo.debug_display_only)) {
		// no-op, just continue
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_BASECOLOR) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(imageLoad(base_color_a, pix).rgb), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_BASEALPHA) {
		imageStore(out_hdr_composed, pix, imageLoad(base_color_a, pix).aaaa); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_EMISSIVE) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(imageLoad(emissive, pix).rgb), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_MATERIAL) {
		imageStore(out_hdr_composed, pix, vec4(imageLoad(material_rmxx, pix).rg, 0., 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_NSHADE) {
		imageStore(out_hdr_composed, pix, vec4(.5 + shading_normal * .5, 0.));
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_NGEOM) {
		imageStore(out_hdr_composed, pix, vec4(.5 + geometry_normal * .5, 0.));
		return;
	}


	Components c;
	c.direct_diffuse = imageLoad(direct_diffuse, pix).rgb;
	c.direct_specular = imageLoad(direct_specular, pix).rgb;
	c.indirect_diffuse = imageLoad(indirect_diffuse_denoised_by_sh, pix).rgb;
	c.indirect_specular = imageLoad(temporal_indirect_specular, pix).rgb;
	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_SEPARATED_REFLECTION) != 0u)
		c.indirect_specular = restoreSpecular(c.indirect_specular, base_color, metalness);

	if (bloomDisplay(ubo.ubo.debug_display_only)) {
		// Skip
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.direct_diffuse + c.direct_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT_DIFF) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.direct_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIRECT_SPEC) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.direct_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.indirect_diffuse + c.indirect_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT_SPEC) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.indirect_specular), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_INDIRECT_DIFF) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.indirect_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DIFFUSE) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.indirect_diffuse + c.direct_diffuse), 0.)); return;
		return;
	} else if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_SPECULAR) {
		imageStore(out_hdr_composed, pix, vec4(LINEARtoSRGB(c.indirect_specular + c.direct_specular), 0.)); return;
		return;
	}

    if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_DIFF ||
        ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_SPEC) {
        imageStore(out_hdr_composed, pix, vec4(ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_DIFF ?
            c.direct_diffuse : c.direct_specular, 0));
        return;
    }
    if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_SIGMA_DIFF ||
        ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_SIGMA_SPEC) {
        vec2 sigma = imageLoad(heitz_noise_blurred, pix).zw;
        // Noise-to-sigma mapping stays in the shadow pass.
        imageStore(out_hdr_composed, pix, vec4(vec3(ubo.ubo.debug_display_only == DEBUG_DISPLAY_SHADOW_SIGMA_DIFF ? sigma.x : sigma.y), 0));
        return;
    }

	vec3 diffuse = c.direct_diffuse + c.indirect_diffuse;
	vec3 specular = c.direct_specular + c.indirect_specular;

	vec3 colour = vec3(0.);

	if (ubo.ubo.debug_display_only != DEBUG_DISPLAY_LIGHTING) {
		colour = mixFinalColor(base_color, diffuse, specular, metalness);
	} else {
		colour = diffuse + specular;
	}

	const vec4 legacy_blend = imageLoad(legacy_blend, pix);

	const vec4 transmission = imageLoad(refraction, pix);
	const vec3 emission = transmission.a > 0.0 ? vec3(0) : imageLoad(emissive, pix).rgb;
	if (transmission.a > 0.0)
		colour = transmission.rgb;
    const vec3 lighting = colour;
    colour = (lighting + emission) * legacy_blend.a;

    const float exposure = readAutoExposure(res);
    updateAutoExposureTemporalData(res, pix, colour);
    colour *= exposure;

    // Sky shares the emissive image, but does not get the material emission boost.
    const float emission_weight = imageLoad(position_t, pix).w > 0.0
        ? BLOOM_EMISSION_WEIGHT : BLOOM_SKY_WEIGHT;
    vec3 source = vec3(0.0);
    if (ubo.ubo.bloom_enabled != 0u && bloomDisplay(ubo.ubo.debug_display_only)) {
        source = bloomBrightPass(emission * legacy_blend.a * exposure) * emission_weight
            + bloomBrightPass(lighting * legacy_blend.a * exposure) * BLOOM_LIGHTING_WEIGHT;
    }
    imageStore(out_bloom_a, pix, vec4(min(source, vec3(65504.0)), 0.0));

    // Existing debug outputs already contain display-encoded colour.
    if (ubo.ubo.debug_display_only == DEBUG_DISPLAY_BLOOM_SOURCE)
        colour = LINEARtoSRGB(source);
    else if (!bloomDisplay(ubo.ubo.debug_display_only) ||
        (ubo.ubo.debug_display_only == DEBUG_DISPLAY_DISABLED && ubo.ubo.bloom_enabled == 0u))
        colour = LINEARtoSRGB(colour) + legacy_blend.rgb;

	DEBUG_VALIDATE_RANGE_VEC3("denoiser.colour", colour, 0., 1e6);

	imageStore(out_hdr_composed, pix, vec4(colour, 0./*unused*/));
}
