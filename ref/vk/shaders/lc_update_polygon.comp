#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_16bit_storage : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#define RAY_QUERY

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 20, rgba16f) uniform readonly image2D lc_point;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D out_lc_radiance;

#include "lc_update_common.glsl"

vec3 polygonRadiance(PolygonLight l, vec3 P, vec3 N)
{
    uint offset = l.vertices_count_offset & 65535u, count = l.vertices_count_offset >> 16;
    if (count < 3u || l.area <= 0.0)
        return vec3(0);

    vec3 a = lights.m.polygon_vertices[offset].xyz;
    float total = 0.0;
    vec3 center = vec3(0);

    // Area-weighted centroid, independent of the polygon's triangulation.
    for (uint i = 1u; i + 1u < count; ++i) {
        vec3 v = lights.m.polygon_vertices[offset + i].xyz;
        vec3 w = lights.m.polygon_vertices[offset + i + 1u].xyz;

        float area = length(cross(v - a, w - a)) * 0.5;

        total += area;
        center += ((a + v + w) / 3.0) * area;
    }

    if (total <= 0.0)
        return vec3(0);

    vec3 d = center / total - P;
    float distance = length(d);
    if (distance < 0.02)
        return vec3(0);

    vec3 L = d / distance;
    vec3 value = lcDiffuse(l.emissive * (total * max(-dot(l.plane.xyz, L), 0.0) / (distance * distance)), N, L);

    return lcWeight(value) > 0.0 && !shadowed(P, L, distance) ? value : vec3(0);
}

void updatePixel(ivec2 pix)
{
    ivec2 res = ivec2(LIGHTCACHE_SIDE);
    vec3 value = vec3(0);
    uint index = lightcacheIndex(pix);

    if (lightcacheInCapacity(index, res) && !lightcacheUpdateDisabled()) {
        vec3 P, N;
        lightcacheSurface(index, P, N);

        uint cluster;
        if (lcLoadCluster(P, cluster)) {
            uint count = min(uint(light_grid.clusters_[cluster].num_polygons), MAX_VISIBLE_SURFACE_LIGHTS);

            for (uint j = 0u; j < count; ++j) {
                uint id = uint(light_grid.clusters_[cluster].polygons[j]);
                if (id >= lights.m.num_polygons)
                    continue;

                value += polygonRadiance(lights.m.polygons[id], P, N);
            }
        }
    }

    // Point update runs first; publish the combined cache without another pass.
    value += imageLoad(lc_point, pix).rgb;
    imageStore(out_lc_radiance, pix, vec4(clamp(value, vec3(0), vec3(65504)), 0));
}
