#version 460
#extension GL_GOOGLE_include_directive : require

#define GLSL
#include "ray_interop.h"
#undef GLSL
#include "utils.glsl"
#include "spherical_harmonics.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D sh1_ping;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D sh2_ping;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D prev_temporal_gi_sh1;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D prev_temporal_gi_sh2;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D out_temporal_gi_sh1;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D out_temporal_gi_sh2;
layout(set = 0, binding = 7, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 8, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D prev_position_t;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D prev_normals_gs;

#include "lc_reprojection.glsl"

const float GI_SH_MAX_HISTORY = 8.0;
const float GI_SH_MIN_NORMAL_DOT = 0.9;

bool validSH(SH value) {
    return !any(isnan(value.shY)) && !any(isinf(value.shY)) &&
        !any(isnan(value.CoCg)) && !any(isinf(value.CoCg));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy), res = ubo.ubo.res;
    if (any(greaterThanEqual(pix, res))) return;

    // Always write both targets, including sky, disabled GI and invalid samples.
    SH current = SH(vec4(0), vec2(0));
    float age = 0.0;
    float mode = (ubo.ubo.renderer_flags & RENDERER_FLAG_GI_POISSON) != 0u ? 1.0 : -1.0;
    float frame = float((ubo.ubo.frame_counter & 1023u) + 1u);
    vec4 position = imageLoad(position_t, pix);
    bool enabled = (ubo.ubo.renderer_flags & RENDERER_FLAG_DENOISE_GI_BY_SH) != 0u && position.w > 0.0;
    if (enabled) {
        current = SH(imageLoad(sh1_ping, pix), imageLoad(sh2_ping, pix).xy);
        bool current_valid = validSH(current);
        if (!current_valid) current = SH(vec4(0), vec2(0));
        age = current_valid ? 1.0 : 0.0;

        bool temporal = (ubo.ubo.renderer_flags & RENDERER_FLAG_GI_SH_TEMPORAL) != 0u &&
            (ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_REPROJECTION) == 0u;
        vec3 previous_position = imageLoad(geometry_prev_position, pix).xyz;
        vec2 projected;
        float clip_w;
        if (temporal && projectWorldToPrevFrameUvCenter(previous_position, res, projected, clip_w)) {
            ivec2 taps[4];
            float weights[4];
            buildReprojectionFootprint2x2(projected, taps, weights);
            // SH coefficients describe world-space incident lighting. Normal maps
            // must not participate in their history validation or accumulation.
            vec3 geometry_normal = normalDecode(imageLoad(normals_gs, pix).xy);
            float previous_depth = length(previous_position - ubo.ubo.prev_inv_view[3].xyz);
            float tolerance = max(0.05, previous_depth * max(0.003, 2.0 * ubo.ubo.ray_cone_width));
            float previous_frame = float(((ubo.ubo.frame_counter - 1u) & 1023u) + 1u);
            SH history = SH(vec4(0), vec2(0));
            float age_sum = 0.0, weight_sum = 0.0;
            for (int i = 0; i < 4; ++i) {
                ivec2 tap = taps[i];
                if (weights[i] <= 0.0 || !isReprojectionTexelInside(tap, res)) continue;
                vec4 donor_position = imageLoad(prev_position_t, tap);
                vec3 donor_normal = normalDecode(imageLoad(prev_normals_gs, tap).xy);
                vec4 metadata = imageLoad(prev_temporal_gi_sh2, tap);
                float donor_age = metadata.z * mode;
                if (donor_position.w <= 0.0 || metadata.w != previous_frame ||
                    !(donor_age >= 1.0 && donor_age <= GI_SH_MAX_HISTORY) ||
                    dot(geometry_normal, donor_normal) < GI_SH_MIN_NORMAL_DOT ||
                    abs(dot(previous_position - donor_position.xyz, donor_normal)) > tolerance) continue;
                SH donor = SH(imageLoad(prev_temporal_gi_sh1, tap), metadata.xy);
                if (!validSH(donor)) continue;
                accumulate_SH(history, donor, weights[i]);
                age_sum += donor_age * weights[i];
                weight_sum += weights[i];
            }
            if (weight_sum > 0.0) {
                history.shY /= weight_sum;
                history.CoCg /= weight_sum;
                // Normalize the age over the same accepted footprint as the SH.
                float effective_age = min(age_sum / weight_sum, GI_SH_MAX_HISTORY - 1.0);
                if (current_valid) {
                    age = 1.0 + effective_age;
                    float blend = effective_age / age;
                    current.shY = mix(current.shY, history.shY, blend);
                    current.CoCg = mix(current.CoCg, history.CoCg, blend);
                } else {
                    current = history;
                    age = max(effective_age, 1.0);
                }
            }
        }
        // A bypassed frame must not become a valid temporal donor on re-enable.
        if (!temporal) age = 0.0;
    }
    imageStore(out_temporal_gi_sh1, pix, current.shY);
    imageStore(out_temporal_gi_sh2, pix, vec4(current.CoCg, mode * age, frame));
}
