#version 460
#include "utils.glsl"
#define GLSL
#include "ray_interop.h"
#undef GLSL
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D normals_gs;
#include "heitz_shadow_common.glsl"
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D out_heitz_noise;
#include "heitz_shadow_raw.glsl"

void main() {
	const ivec2 p = ivec2(gl_GlobalInvocationID.xy), res = ubo.ubo.res;
	if (!heitzInside(p, res)) return;
	const vec4 center = imageLoad(position_t, p);
	vec2 noise = vec2(0.0);
	if (center.w > 0.0) {
		const vec3 normal = normalDecode(imageLoad(normals_gs, p).xy);
		// Four uniformly angled lines, with a stable per-pixel rotation.
		const uint hash = (uint(p.x) * 1664525u) ^ (uint(p.y) * 1013904223u);
		const float angle = float(hash & 65535u) * (0.785398163 / 65536.0);
		for (int line = 0; line < 4; ++line) {
			const float theta = angle + float(line) * 0.785398163;
			const vec2 direction = vec2(cos(theta), sin(theta));
			vec3 prev_d = vec3(1.0), prev_s = vec3(1.0);
			vec3 gradient_d = vec3(0.0), gradient_s = vec3(0.0);
			bool valid_previous = false, valid_gradient = false;
			for (int t = -5; t <= 5; ++t) {
				const ivec2 tap = p + ivec2(round(direction * float(t)));
				if (!heitzInside(tap, res) || heitzGeometryWeight(center, normal, tap) < 0.5) {
					valid_previous = valid_gradient = false;
					continue;
				}
				vec3 sd, ud, ss, us;
				heitzRaw(tap, sd, ud, ss, us);
				const vec3 wd = heitzRatio(sd, ud), ws = heitzRatio(ss, us);
				const vec3 gd = wd - prev_d, gs = ws - prev_s;
				if (valid_gradient) {
					noise += vec2(length(gd - gradient_d), length(gs - gradient_s)) / 1.732050808;
				}
				valid_gradient = valid_previous;
				valid_previous = true;
				gradient_d = gd; gradient_s = gs;
				prev_d = wd; prev_s = ws;
			}
		}
	}
	imageStore(out_heitz_noise, p, vec4(noise / 36.0, 0.0, 0.0));
}
