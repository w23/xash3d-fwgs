void readNormals(ivec2 uv, out vec3 geometry_normal, out vec3 shading_normal) {
	const vec4 n = imageLoad(normals_gs, uv);
	geometry_normal = normalDecode(n.xy);
	shading_normal = normalDecode(n.zw);
}

struct TemporalReflectionLuminancePacked {
	vec4 diffuse0;
	vec4 diffuse1;
	vec4 specular0;
	vec4 specular1;
};

struct TemporalReflectionIndexPacked {
	vec4 index0;
	vec4 index1;
};

uvec4 decodeTemporalIndexPacked(vec4 packed) {
	return uvec4(
		packed.x < 0.0 ? BRIGHTEST_LIGHT_INVALID_INDEX : uint(floor(packed.x)),
		packed.y < 0.0 ? BRIGHTEST_LIGHT_INVALID_INDEX : uint(floor(packed.y)),
		packed.z < 0.0 ? BRIGHTEST_LIGHT_INVALID_INDEX : uint(floor(packed.z)),
		packed.w < 0.0 ? BRIGHTEST_LIGHT_INVALID_INDEX : uint(floor(packed.w)));
}

vec4 encodeTemporalIndexPacked(uvec4 indices) {
	return vec4(
		indices.x == BRIGHTEST_LIGHT_INVALID_INDEX ? -1.0 : float(indices.x),
		indices.y == BRIGHTEST_LIGHT_INVALID_INDEX ? -1.0 : float(indices.y),
		indices.z == BRIGHTEST_LIGHT_INVALID_INDEX ? -1.0 : float(indices.z),
		indices.w == BRIGHTEST_LIGHT_INVALID_INDEX ? -1.0 : float(indices.w));
}

void loadPrevTemporalReflectionBrightest(ivec2 p, out BrightestLights brightest) {
	TemporalReflectionLuminancePacked luminancePacked;
	TemporalReflectionIndexPacked indexPacked;
	luminancePacked.diffuse0 = imageLoad(prev_temporal_reflection_0, p);
	luminancePacked.diffuse1 = imageLoad(prev_temporal_reflection_1, p);
	luminancePacked.specular0 = imageLoad(prev_temporal_reflection_2, p);
	luminancePacked.specular1 = imageLoad(prev_temporal_reflection_3, p);
	indexPacked.index0 = imageLoad(prev_temporal_reflection_4, p);
	indexPacked.index1 = imageLoad(prev_temporal_reflection_5, p);

	brightest.diffuse_luminance0 = luminancePacked.diffuse0;
	brightest.diffuse_luminance1 = luminancePacked.diffuse1;
	brightest.specular_luminance0 = luminancePacked.specular0;
	brightest.specular_luminance1 = luminancePacked.specular1;
	brightest.indices0 = decodeTemporalIndexPacked(indexPacked.index0);
	brightest.indices1 = decodeTemporalIndexPacked(indexPacked.index1);
}

void storeTemporalReflectionBrightest(ivec2 p, BrightestLights brightest, bool confidence_disabled) {
	TemporalReflectionLuminancePacked luminancePacked;
	TemporalReflectionIndexPacked indexPacked;
	if (confidence_disabled) {
		luminancePacked.diffuse0 = vec4(0.0);
		luminancePacked.diffuse1 = vec4(0.0);
		luminancePacked.specular0 = vec4(0.0);
		luminancePacked.specular1 = vec4(0.0);
		indexPacked.index0 = vec4(-1.0);
		indexPacked.index1 = vec4(-1.0);
	} else {
		luminancePacked.diffuse0 = brightest.diffuse_luminance0;
		luminancePacked.diffuse1 = brightest.diffuse_luminance1;
		luminancePacked.specular0 = brightest.specular_luminance0;
		luminancePacked.specular1 = brightest.specular_luminance1;
		indexPacked.index0 = encodeTemporalIndexPacked(brightest.indices0);
		indexPacked.index1 = encodeTemporalIndexPacked(brightest.indices1);
	}

	imageStore(out_temporal_reflection_0, p, luminancePacked.diffuse0);
	imageStore(out_temporal_reflection_1, p, luminancePacked.diffuse1);
	imageStore(out_temporal_reflection_2, p, luminancePacked.specular0);
	imageStore(out_temporal_reflection_3, p, luminancePacked.specular1);
	imageStore(out_temporal_reflection_4, p, indexPacked.index0);
	imageStore(out_temporal_reflection_5, p, indexPacked.index1);
}
const int kMaxBounces = 1;
const vec3 kThrougputExtinctionThreshold = vec3(1e-3);
const float kBounceRayNormalOffset = .02;
const float kBounceRayMinT = .005;
const float kBounceLightingNormalOffset = .01;

ivec2 pix;
vec3 offsetRayOrigin(vec3 pos, vec3 geometry_normal, vec3 ray_dir, float eps) {
	const float normal_sign = dot(geometry_normal, ray_dir) >= 0.0 ? 1.0 : -1.0;
	return pos + geometry_normal * (eps * normal_sign);
}

bool getHit(vec3 origin, vec3 direction, inout RayPayloadPrimary payload) {
	rayQueryEXT rq;
	const uint flags = 0
		| gl_RayFlagsCullFrontFacingTrianglesEXT
		//| gl_RayFlagsOpaqueEXT
		//| gl_RayFlagsTerminateOnFirstHitEXT
		//| gl_RayFlagsSkipClosestHitShaderEXT
		;

	const float L = 10000.; // TODO Why 10k? Use the real max distance, as in ray_primary.comp
	rayQueryInitializeEXT(rq, tlas, flags, GEOMETRY_BIT_OPAQUE | GEOMETRY_BIT_ALPHA_TEST, origin, kBounceRayMinT, direction, L);
	while (rayQueryProceedEXT(rq)) {
		if (0 != (rayQueryGetRayFlagsEXT(rq) & gl_RayFlagsOpaqueEXT))
			continue;

		// alpha test
		// TODO check other possible ways of doing alpha test. They might be more efficient
		// (although in this particular primary ray case it's not taht important):
		// 1. Do a separate ray query for alpha masked geometry. Reason: here we might accidentally do the expensive
		//    texture sampling for geometry that's ultimately invisible (i.e. behind walls). Also, shader threads congruence.
		//    Separate pass could be more efficient as it'd be doing the same thing for every invocation.
		// 2. Same as the above, but also with a completely independent TLAS. Why: no need to mask-check geometry for opaque-vs-alpha
		const MiniGeometry geom = readCandidateMiniGeometry(rq);
		const uint tex_base_color = getKusok(geom.kusok_index).material.tex_base_color;
		// tex_base_color cannot be TEX_BASE_SKYBOX, as skybox is opaque
		const vec4 texture_color = texture(textures[nonuniformEXT(tex_base_color)], geom.uv);

		const float alpha_mask_threshold = .1f;
		if (texture_color.a >= alpha_mask_threshold) {
			rayQueryConfirmIntersectionEXT(rq);
		}
	}

	if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
		payload.hit_t.w = L;
		payload.emissive.rgb = sampleSkybox(direction);
		return false;
	} else {
		payload.emissive.rgb = vec3(0.); // emissive polygons already calculated in directional polygon lighting pass (remove fireflyes here)
	}

	primaryRayHit(rq, payload);
	const bool hit_skybox = payload.hit_t.w < 0.;
	if (hit_skybox) {
		payload.hit_t.w *= -1;
		return false;
	}

	return true;
}
const int INDIRECT_SCALE = 2;

struct MaterialEx {
	MaterialProperties prop;
	vec3 geometry_normal, shading_normal;
	//TODO float alpha;
};


void computeBounces(
	MaterialEx mat,
	vec3 pos,
	vec3 direction,
	int bouncesCount,
	inout vec3 diffuse,
	inout vec3 specular,
	inout vec3 first_bounce_direction,
	bool track_first_bounce_temporal,
	inout vec3 first_bounce_hit_position,
	inout vec3 first_bounce_lighting_position,
	inout vec3 first_bounce_shading_normal,
	inout float first_bounce_roughness,
	inout BrightestLights first_bounce_brightest_lights,
	out bool first_bounce_did_hit) {
	vec3 throughput = vec3(1.);

	// TODO split into two distinct passes, see #734
	int first_brdf_type = BRDF_TYPE_NONE;
	first_bounce_did_hit = false;
	if (track_first_bounce_temporal) {
		initBrightestLights(first_bounce_brightest_lights);
	}

	for (int i = 0; i < bouncesCount; ++i) {
		vec3 bounce_direction;

		// TODO blue noise
		const vec2 rnd = vec2(rand01(), rand01());
		const int brdf_type = brdfGetSample(rnd, mat.prop, -direction, mat.geometry_normal, mat.shading_normal/* TODO, mat.base_color_a.a*/, bounce_direction, throughput);

		if (brdf_type == BRDF_TYPE_NONE)
			return;

		if (IS_INVALIDV(throughput)) {
#ifdef SHADER_DEBUG_ENABLE
			debugPrintfEXT("pix=(%d,%d) pos=(%f,%f,%f) dir=(%f,%f,%f) throughput=invalid",
				pix.x, pix.y, pos.x, pos.y, pos.z, direction.x, direction.y, direction.z);
#endif
			throughput = vec3(0.);
		}

/*
		if (any(lessThan(throughput, vec3(0.)))) {
#ifdef SHADER_DEBUG_ENABLE
			debugPrintfEXT("pix=(%d,%d) pos=(%f,%f,%f) dir=(%f,%f,%f) throughput=(%f, %f, %f)",
				pix.x, pix.y, pos.x, pos.y, pos.z, direction.x, direction.y, direction.z,
				throughput.r, throughput.g, throughput.b
				);
#endif
		}
*/

		if (all(lessThan(throughput, kThrougputExtinctionThreshold)))
			return;

		if (first_brdf_type == BRDF_TYPE_NONE)
			first_brdf_type = brdf_type;

		RayPayloadPrimary payload;
		payload.base_color_a = vec4(0.);
		payload.emissive = vec4(0.);
		payload.material_rmxx = vec4(0.);
		payload.normals_gs = vec4(0.);

		vec3 contribution = vec3(0.);
		const vec3 ray_origin = offsetRayOrigin(pos, mat.geometry_normal, bounce_direction, kBounceRayNormalOffset);

		vec3 hit_color = vec3(0.);
		// FIXME figure out how could this happen, see https://github.com/w23/xash3d-fwgs/issues/771
		if (any(isnan(bounce_direction)))
			break;
		const bool did_hit = getHit(ray_origin, bounce_direction, payload);
		MaterialProperties hit_material;
		const vec3 hit_pos = payload.hit_t.xyz;
		const vec3 hit_geometry_normal = normalDecode(payload.normals_gs.xy);
		const vec3 hit_shading_normal = normalDecode(payload.normals_gs.zw);
		const bool track_brightest_lights = track_first_bounce_temporal && i == 0;
		BrightestLights bounce_brightest_lights;
		if (did_hit) {
			vec3 ldiffuse = vec3(0.);
			vec3 lspecular = vec3(0.);
			hit_material.base_color = payload.base_color_a.rgb;
			hit_material.metalness = payload.material_rmxx.g;
			hit_material.roughness = payload.material_rmxx.r;

#ifdef DEBUG_VALIDATE_EXTRA
		if (IS_INVALIDV(hit_pos)) {
			debugPrintfEXT("bounce.comp:%d INVALID hit_pos=(%f,%f,%f)",
				__LINE__, PRIVEC3(hit_pos));
			break;
		}
#endif
			const vec3 hit_lighting_pos = hit_pos + hit_geometry_normal * kBounceLightingNormalOffset;
			computeLighting(hit_lighting_pos, hit_shading_normal, -bounce_direction, hit_material, ldiffuse, lspecular, bounce_brightest_lights, track_brightest_lights);

			if (IS_INVALIDV(ldiffuse)) {
#ifdef SHADER_DEBUG_ENABLE
				debugPrintfEXT("pix=(%d,%d) pos=(%f,%f,%f) dir=(%f,%f,%f) ldiffuse=invalid",
					pix.x, pix.y, pos.x, pos.y, pos.z, direction.x, direction.y, direction.z);
#endif
				ldiffuse = vec3(0.);
			}

			if (IS_INVALIDV(lspecular)) {
#ifdef SHADER_DEBUG_ENABLE
				debugPrintfEXT("pix=(%d,%d) pos=(%f,%f,%f) dir=(%f,%f,%f) lspecular=invalid",
					pix.x, pix.y, pos.x, pos.y, pos.z, direction.x, direction.y, direction.z);
#endif
				lspecular = vec3(0.);
			}

			hit_color = mixFinalColor(payload.base_color_a.rgb, ldiffuse, lspecular, hit_material.metalness);
		} /* if (did_hit) */ else {
			// not hit -- hit sky
			hit_color = payload.emissive.rgb;
		}

		const vec4 blend = traceLegacyBlending(ray_origin, bounce_direction, payload.hit_t.w);
		contribution = throughput * (SRGBtoLINEAR(blend.rgb) + hit_color * blend.a);

		if (first_brdf_type == BRDF_TYPE_DIFFUSE)
			diffuse += contribution;
		else
			specular += contribution;

		if (i == 0) {
			first_bounce_direction = hit_pos - pos;
			if (track_first_bounce_temporal) {
				first_bounce_did_hit = did_hit;
				if (did_hit) {
					first_bounce_hit_position = hit_pos;
					first_bounce_lighting_position = hit_pos + hit_geometry_normal * kBounceLightingNormalOffset;
					first_bounce_shading_normal = hit_shading_normal;
					first_bounce_roughness = hit_material.roughness;
					if (track_brightest_lights) {
						first_bounce_brightest_lights = bounce_brightest_lights;
						finalizeBrightestLightsWeights(first_bounce_brightest_lights, first_bounce_lighting_position, first_bounce_shading_normal, normalize(pos - first_bounce_lighting_position), first_bounce_roughness);
					}
				}
			}
		}

		if (!did_hit)
			break;

		// Prepare next bounce state
		pos = hit_pos;
		direction = bounce_direction;
		mat.prop = hit_material;
		mat.geometry_normal = hit_geometry_normal;
		mat.shading_normal = hit_shading_normal;

		if (brdf_type == BRDF_TYPE_DIFFUSE) {
			const vec3 diffuse_color = mix(payload.base_color_a.rgb, vec3(0.), payload.material_rmxx.g);
			throughput *= diffuse_color;
		}
	} // for bounces
}

void main() {
	pix = ivec2(gl_GlobalInvocationID);
	const ivec2 res = ubo.ubo.res / INDIRECT_SCALE;
	if (any(greaterThanEqual(pix, res))) {
		return;
	}
	const vec2 uv = (gl_GlobalInvocationID.xy + .5) / res * 2. - 1.;

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_GI) != 0) {
		imageStore(out_indirect_diffuse, pix, vec4(0.));
		imageStore(out_indirect_specular, pix, vec4(0.));
		return;
	}

#ifdef BRDF_COMPARE
	g_mat_gltf2 = pix.x > ubo.ubo.res.x / INDIRECT_SCALE / 2.;
#endif

	const vec4 pos_t = imageLoad(position_t, pix * INDIRECT_SCALE);
	vec3 diffuse = vec3(0.), specular = vec3(0.);
	vec3 first_bounce_direction = vec3(0.), reflection_direction = vec3(0.);
	bool confidence_disabled = (ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_CONFIDENCE) != 0;
	vec2 reflection_confidence = vec2(1.0);
	vec3 reflection_hit_position = vec3(0.0);
	vec3 reflection_shading_normal = vec3(0.0);
	float reflection_roughness = 0.0;
	BrightestLights reflection_brightest_lights;
	initBrightestLights(reflection_brightest_lights);
	if (pos_t.w > 0.) {
		const vec3 origin    = (ubo.ubo.inv_view * vec4(0, 0, 0, 1)).xyz;
		const vec4 target    = ubo.ubo.inv_proj * vec4(uv.x, uv.y, 1, 1);
		const vec3 direction = normalize((ubo.ubo.inv_view * vec4(target.xyz, 0)).xyz);

		rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337 + 12;

		const vec4 material_data = imageLoad(material_rmxx, pix * INDIRECT_SCALE);
		const vec4 base_a = SRGBtoLINEAR(imageLoad(base_color_a, pix * INDIRECT_SCALE));

		vec3 geometry_normal, shading_normal;
		readNormals(pix * INDIRECT_SCALE, geometry_normal, shading_normal);

		MaterialEx mat;
		mat.prop.base_color = base_a.rgb;
		mat.geometry_normal = geometry_normal;
		mat.shading_normal = shading_normal;

		if ((ubo.ubo.renderer_flags & RENDERER_FLAG_ONLY_DIFFUSE_GI) != 0) {
			mat.prop.metalness = 0.0;
			mat.prop.roughness = 1.0;
		} else {
			mat.prop.metalness = material_data.g;
			mat.prop.roughness = material_data.r;
		}

		vec3 unused_hit_position = vec3(0.0);
		vec3 unused_lighting_position = vec3(0.0);
		vec3 unused_shading_normal = vec3(0.0);
		float unused_roughness = 0.0;
		BrightestLights unused_brightest_lights;
		initBrightestLights(unused_brightest_lights);
		bool unused_did_hit = false;
		computeBounces(mat, pos_t.xyz, direction, kMaxBounces, diffuse, specular, first_bounce_direction, false, unused_hit_position, unused_lighting_position, unused_shading_normal, unused_roughness, unused_brightest_lights, unused_did_hit);

		if ((ubo.ubo.renderer_flags & RENDERER_FLAG_ONLY_DIFFUSE_GI) != 0) {
			diffuse += specular;
			specular = vec3(0.);
		}

		if ((ubo.ubo.renderer_flags & RENDERER_FLAG_SEPARATED_REFLECTION) != 0) {
			specular = vec3(0.);

			mat.prop.base_color = vec3(1.);
			mat.prop.metalness = 1.0;
			mat.prop.roughness = material_data.r;

			vec3 unusedDiffuse = vec3(0.);
			vec3 reflection_lighting_position = vec3(0.0);
			bool reflection_did_hit = false;
			computeBounces(mat, pos_t.xyz, direction, 1, unusedDiffuse, specular, reflection_direction, !confidence_disabled, reflection_hit_position, reflection_lighting_position, reflection_shading_normal, reflection_roughness, reflection_brightest_lights, reflection_did_hit);

			const float reflection_ray_length = length(reflection_direction);
			if (reflection_did_hit && !confidence_disabled && reflection_ray_length > 0.0) {
				float current_diffuse_weights[BRIGHTEST_LIGHTS_PER_TEXEL];
				float prev_diffuse_weights[BRIGHTEST_LIGHTS_PER_TEXEL];
				float current_specular_weights[BRIGHTEST_LIGHTS_PER_TEXEL];
				float prev_specular_weights[BRIGHTEST_LIGHTS_PER_TEXEL];
				for (int i = 0; i < BRIGHTEST_LIGHTS_PER_TEXEL; ++i) {
					current_diffuse_weights[i] = 0.0;
					prev_diffuse_weights[i] = 0.0;
					current_specular_weights[i] = 0.0;
					prev_specular_weights[i] = 0.0;
				}

				processTemporalDiffuseLightEntries(reflection_brightest_lights, reflection_lighting_position, reflection_shading_normal, normalize(pos_t.xyz - reflection_lighting_position), reflection_roughness, current_diffuse_weights);
				processTemporalSpecularLightEntries(reflection_brightest_lights, reflection_lighting_position, reflection_shading_normal, normalize(pos_t.xyz - reflection_lighting_position), reflection_roughness, current_specular_weights);

				const vec3 prev_position = imageLoad(geometry_prev_position, pix * INDIRECT_SCALE).xyz;
				ivec2 reproj_pix = ivec2(-1);
				float reproj_depth_necessary = 0.0;
				float reproj_depth_threshold = 0.0;
				if (reprojectToPrevFramePixel(prev_position, res, reproj_pix, reproj_depth_necessary, reproj_depth_threshold)) {
					BrightestLights prev_brightest_lights;
					initBrightestLights(prev_brightest_lights);
					loadPrevTemporalReflectionBrightest(reproj_pix, prev_brightest_lights);
					vec3 prev_shading_normal = vec3(0.0);
					float prev_roughness = 0.0;
					unpackTemporalNormalRoughness(imageLoad(prev_temporal_reflection_normal_roughness, reproj_pix), prev_shading_normal, prev_roughness);
					const vec3 prev_hit_position = imageLoad(prev_temporal_reflection_hit, reproj_pix).xyz;
					processTemporalDiffuseLightEntries(prev_brightest_lights, prev_hit_position, prev_shading_normal, normalize(pos_t.xyz - prev_hit_position), prev_roughness, prev_diffuse_weights);
					reflection_confidence.x = computeTemporalDiffuseConfidence(prev_brightest_lights, prev_hit_position, prev_shading_normal, normalize(pos_t.xyz - prev_hit_position), prev_roughness);
				}

				const vec3 prev_origin = (ubo.ubo.prev_inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
				ivec2 parallax_pix = ivec2(-1);
				if (parallaxReprojectToPrevFramePixel(pos_t.xyz, prev_position, geometry_normal, origin, prev_origin, reflection_ray_length, res, parallax_pix)) {
					BrightestLights prev_brightest_lights;
					initBrightestLights(prev_brightest_lights);
					loadPrevTemporalReflectionBrightest(parallax_pix, prev_brightest_lights);
					vec3 prev_shading_normal = vec3(0.0);
					float prev_roughness = 0.0;
					unpackTemporalNormalRoughness(imageLoad(prev_temporal_reflection_normal_roughness, parallax_pix), prev_shading_normal, prev_roughness);
					const vec3 prev_hit_position = imageLoad(prev_temporal_reflection_hit, parallax_pix).xyz;
					float current_prev_specular_weights[BRIGHTEST_LIGHTS_PER_TEXEL];
					for (int i = 0; i < BRIGHTEST_LIGHTS_PER_TEXEL; ++i) {
						BrightestLightEntry prev_entry = getBrightestLightEntry(prev_brightest_lights, i);
						prev_specular_weights[i] = max(prev_entry.specular_luminance, 0.0);
						current_prev_specular_weights[i] = 0.0;
					}
					processTemporalSpecularLightEntries(prev_brightest_lights, prev_hit_position, prev_shading_normal, normalize(pos_t.xyz - prev_hit_position), prev_roughness, current_prev_specular_weights);
					reflection_confidence.y = computeTemporalSpecularConfidence(prev_brightest_lights, prev_hit_position, prev_shading_normal, normalize(pos_t.xyz - prev_hit_position), prev_roughness);
				}
			}
		}
	}

#ifdef DEBUG_VALIDATE_EXTRA
	if (IS_INVALIDV(specular)) {
		debugPrintfEXT("pix=(%d,%d) specular=(%f, %f, %f)", pix.x, pix.y, specular.r, specular.g, specular.b);
		specular = vec3(0.);
	}

	if (IS_INVALIDV(diffuse)) {
		debugPrintfEXT("pix=(%d,%d) diffuse=(%f, %f, %f)", pix.x, pix.y, diffuse.r, diffuse.g, diffuse.b);
		diffuse = vec3(0.);
	}
#else
	DEBUG_VALIDATE_RANGE_VEC3("bounce.diffuse", diffuse, 0., 1e6);
	DEBUG_VALIDATE_RANGE_VEC3("bounce.specular", specular, 0., 1e6);
#endif

	if (any(equal(reflection_direction, vec3(0.)))) {
		reflection_direction = first_bounce_direction;
	}

	storeTemporalReflectionBrightest(pix, reflection_brightest_lights, confidence_disabled);
	imageStore(out_temporal_reflection_normal_roughness, pix, packTemporalNormalRoughness(reflection_shading_normal, reflection_roughness));
	imageStore(out_temporal_reflection_hit, pix, vec4(reflection_hit_position, 0.0));
	imageStore(out_reflection_confidence, pix, confidence_disabled ? vec4(1.0, 1.0, 0.0, 0.0) : vec4(reflection_confidence, 0.0, 0.0));
	imageStore(out_indirect_diffuse, pix, vec4(diffuse, 0.f));
	imageStore(out_indirect_specular, pix, vec4(specular, 0.f));
	imageStore(out_first_bounce_direction, pix, vec4(first_bounce_direction, 0.f)); // for spherical harmonics denoising
	imageStore(out_reflection_direction_pdf, pix, vec4(reflection_direction, 0.f)); // TODO: calculate specular pdf in w for spatial reconstruction
}
