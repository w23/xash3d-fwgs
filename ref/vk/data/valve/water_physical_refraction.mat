// Renderer-shipped Half-Life water defaults, independent of the PBR resource pack.
// Loaded last, after resource-pack and map materials. Explicit values here take precedence.
// inherit $current preserves existing maps, colors and emission sources.
// Glass, toxins and Xen fluids are not overridden.
// Their default refraction_ior 0 preserves vanilla alpha and straight transmission.

{
    "for" "!WATERBLUE"
    "inherit" "$current"
    "refraction_ior" "1.333"
    "metalness" "1"
    "roughness" "0"
    "wave_scale" "1"
    "wave_strength" "1"
}

